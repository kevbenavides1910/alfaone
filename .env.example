# Copiar a .env y .env.local (npm run setup:local lo hace automáticamente)
#
# Docker (docker-compose.yml): Postgres en host:5433
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/alfa_one?schema=public"
#
# Postgres nativo en el PC (sin Docker): suele ser puerto 5432
# DATABASE_URL="postgresql://postgres:password@localhost:5432/alfa_one?schema=public"

# Debe coincidir con la URL del navegador (incluido puerto si no es 3000)
NEXTAUTH_URL="http://localhost:3000"
# Obligatorio (mín. 32 caracteres). Producción: openssl rand -base64 32
NEXTAUTH_SECRET="dev-secret-change-in-production-min32chars!!"

# Secreto separado para firmar tokens JWT de dispositivos móviles Alfa One (no reutilizar NEXTAUTH_SECRET)
# SYNTRA_DEVICE_SECRET="otro-secreto-aleatorio-minimo-32-caracteres!!"

# Almacenamiento en servidor (disco grande): bash scripts/setup-storage.sh
# APP_DATA_HOST="/mnt/storage/apps/alfa-one"
# Ver docs/STORAGE.md

# Local sin Docker:
# BRANDING_UPLOAD_DIR="./uploads/branding"
# EXPENSE_UPLOAD_DIR="./uploads/expenses"

# SMTP opcional — importación «marcas» disciplinario
# SMTP_HOST="smtp.ejemplo.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="Disciplinario <no-reply@ejemplo.com>"

