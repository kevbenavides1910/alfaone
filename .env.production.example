# ─── Copy this file to .env.production on the VPS and fill in real values ───
# Con docker-compose.prod.yml use host `postgres` (nombre del servicio), no localhost:
# DATABASE_URL="postgresql://postgres:TU_PASSWORD@postgres:5432/security_contracts?schema=public"

POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=security_contracts

DATABASE_URL="postgresql://postgres:CHANGE_ME_STRONG_PASSWORD@postgres:5432/security_contracts?schema=public"

# Public URL (sin barra final). Use HTTPS en producción para cookies seguras.
NEXTAUTH_URL="https://presupuestos.ejemplo.com"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="CHANGE_THIS_TO_A_RANDOM_SECRET_MIN_32_CHARS"

# Secreto separado para firmar tokens JWT de dispositivos SYNTRA (no reutilizar NEXTAUTH_SECRET)
# Generar con: openssl rand -base64 32
SYNTRA_DEVICE_SECRET="CHANGE_THIS_TO_A_DIFFERENT_RANDOM_SECRET_MIN_32_CHARS"

# Timezone — critical for date calculations (contract expiry, 6-month cutoff, etc.)
# Must match the timezone where the business operates
TZ="America/Costa_Rica"

# Optional: set Node environment
NODE_ENV="production"

# Disco grande (HDD ~11 TB montado en /mnt/storage). Ver docs/STORAGE.md
APP_DATA_HOST="/mnt/storage/apps/presupuestos-alfa"

# Imagen preconstruida (GHCR). Usada por: npm run ops:deploy:pull
# Tras el primer push a main, CI publica: ghcr.io/kevbenavides1910/alfaone:latest
# APP_IMAGE="ghcr.io/kevbenavides1910/alfaone:latest"

# Sync FE → Frappe (Sales Invoice espejo; no emitir desde ERPNext)
# FRAPPE_BASE_URL="https://frappe.grupocorporativoalfa.com"
# FRAPPE_API_KEY=""
# FRAPPE_API_SECRET=""
# FRAPPE_COMPANY="Grupo Alfa"

# Asistente Syntra IA (opcional si usa scripts/db/sync-syntra-ai-from-odoo.mjs)
# SYNTRA_AI_ENABLED="true"
# SYNTRA_AI_PROVIDER="opencode_go"
# SYNTRA_AI_API_KEY=""
# SYNTRA_AI_BASE_URL="https://opencode.ai/zen/go/v1"
# SYNTRA_AI_MODEL="deepseek-v4-pro"
