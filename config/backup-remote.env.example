# Copiar a /etc/presupuestos-alfa/backup-remote.env (chmod 640)
# y ejecutar: sudo bash scripts/setup-backup-remote.sh

# 1 = activar copia al servidor remoto tras cada respaldo local
BACKUP_REMOTE_ENABLED=1

# Servidor destino (otro VPS, NAS, etc.)
BACKUP_REMOTE_HOST=10.1.1.XXX
BACKUP_REMOTE_USER=backup
BACKUP_REMOTE_PORT=22

# Carpeta en el servidor remoto (se creará si no existe)
BACKUP_REMOTE_PATH=/backups/presupuestos-alfa/postgres

# Clave SSH dedicada (sin contraseña) — ruta en ESTE servidor
BACKUP_REMOTE_SSH_KEY=/home/soporte-ti/.ssh/presupuestos_alfa_backup

# Origen local (mismo que postgres-backup.sh)
BACKUP_LOCAL_DIR=/mnt/data/backups/postgres

# Retención en el remoto (días); 0 = no borrar en remoto
BACKUP_REMOTE_RETENTION_DAYS=30
