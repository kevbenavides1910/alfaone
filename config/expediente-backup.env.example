# Copiar a /etc/alfa-one/expediente-backup.env y ajustar si hace falta.
# sudo install -m 640 -o soporte-ti -g root config/expediente-backup.env.example /etc/alfa-one/expediente-backup.env

# Origen (filesystem nativo en Oracle — preferido; no usa CIFS)
ORACLE_HOST=10.1.1.6
ORACLE_USER=oracle
ORACLE_EXPEDIENTE_PATH=/u01/EXPEDIENTE_DIGITAL

# Destino en este VPS (.229 / alfaia)
BACKUP_ROOT=/mnt/data/backups/expediente-digital

# Retención de snapshots hardlink (días). El mirror "current" siempre se actualiza.
SNAPSHOT_RETENTION_DAYS=7

# false = no borrar en destino archivos que ya no existen en origen (más seguro al inicio)
# true  = espejo exacto (recomendado cuando el primer sync ya terminó bien)
RSYNC_DELETE=true
