# Copiar a /etc/alfa-one/health-alert.env (chmod 600)
# o ejecutar: sudo bash scripts/setup-health-alert-email.sh

# Destinatario(s), separados por coma
HEALTH_ALERT_TO=kevbenavides@gmail.com

# Remitente (debe estar autorizado en su SMTP; Gmail = misma cuenta que SMTP_USER)
HEALTH_ALERT_FROM=alertas@grupocorporativoalfa.com

# SMTP (Gmail: usar contraseña de aplicación, no la contraseña normal)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=1
SMTP_USER=su-cuenta@gmail.com
SMTP_PASS=contraseña-de-aplicacion

# No reenviar la misma alerta antes de N minutos
HEALTH_ALERT_COOLDOWN_MINUTES=30

# Nombre del servidor en el asunto
HEALTH_ALERT_HOSTNAME=alfa-one
