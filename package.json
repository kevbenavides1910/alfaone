{
  "name": "alfa-one",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "node -e \"const fs=require('fs'); try { fs.rmSync('.next',{recursive:true,force:true}); console.log('Carpeta .next eliminada.'); } catch (e) { console.error(e.message); process.exit(1); }\"",
    "dev": "next dev",
    "dev:gen": "prisma generate && next dev",
    "dev:3000": "next dev --hostname 127.0.0.1 -p 3000",
    "dev:gen:3000": "prisma generate && next dev --hostname 127.0.0.1 -p 3000",
    "dev:clean": "npm run clean && next dev",
    "dev:clean:3000": "npm run clean && next dev --hostname 127.0.0.1 -p 3000",
    "dev:clean:gen": "npm run clean && prisma generate && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "ci:modules": "node scripts/ci/affected-modules.mjs",
    "ci:local": "npm run ci:modules && npm run lint && npm run build",
    "setup:local": "node scripts/setup-local.mjs",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:fix-planilla-enum": "prisma db execute --file prisma/fix-expense-type-planilla.sql --schema prisma/schema.prisma",
    "db:fix-user-role-enum": "prisma db execute --file prisma/fix-user-role-enum.sql --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev",
    "db:seed": "ts-node prisma/seed.ts",
    "db:seed-roles": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed-roles.ts",
    "db:seed-syntra": "node prisma/seed-syntra-device.mjs",
    "db:reset-admin-passwords": "node prisma/reset-admin-password.js",
    "db:clear-business": "ts-node prisma/clear-business-data.ts",
    "db:clear-business:prod": "node prisma/clear-business-data.mjs",
    "db:clear-disciplinary": "ts-node prisma/clear-disciplinary-data.ts",
    "db:import-contracts": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/import-contracts-from-xlsx.ts",
    "db:seed-billing-requirements": "ts-node --compiler-options {\"module\":\"CommonJS\"} scripts/seed-contract-billing-requirements.ts",
    "ops:backup": "bash scripts/postgres-backup.sh",
    "ops:backup-remote": "bash scripts/postgres-backup-remote-sync.sh",
    "ops:setup-backup-remote": "sudo bash scripts/setup-backup-remote.sh",
    "ops:health": "bash scripts/vps-health-monitor.sh",
    "ops:harden-env": "bash scripts/harden-production-env.sh",
    "ops:install-cron": "sudo bash scripts/install-production-cron.sh",
    "ops:setup-health-email": "sudo bash scripts/setup-health-alert-email.sh",
    "ops:daily-report": "bash scripts/vps-health-daily-report.sh",
    "db:import-expenses": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/import-expenses-from-xlsx.ts",
    "db:import-client-contacts": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/import-client-contacts-from-xlsx.ts",
    "db:import-cxc": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/import-cxc-from-xlsx.ts",
    "db:import-bandeco": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/import-bandeco-from-xlsm.ts",
    "db:seed-bandeco-permissions": "node prisma/seed-bandeco-permissions.mjs",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset"
  },
  "postinstall": "prisma generate",
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.2",
    "@hookform/resolvers": "^3.9.0",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.2",
    "@radix-ui/react-tooltip": "^1.1.4",
    "@tanstack/react-query": "^5.59.0",
    "@tanstack/react-table": "^8.20.5",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.456.0",
    "mammoth": "^1.12.0",
    "next": "16.2.9",
    "next-auth": "^4.24.14",
    "nodemailer": "^7.0.13",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.2",
    "react-leaflet": "^4.2.1",
    "recharts": "^2.13.3",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.20",
    "eslint": "^8",
    "eslint-config-next": "15.0.3",
    "postcss": "^8",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
