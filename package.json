{
  "name": "alfa-one",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "node -e \"const fs=require('fs'); try { fs.rmSync('.next',{recursive:true,force:true}); console.log('Carpeta .next eliminada.'); } catch (e) { console.error(e.message); process.exit(1); }\"",
    "dev": "next dev",
    "dev:gen": "prisma generate && next dev",
    "dev:3000": "next dev --hostname 127.0.0.1 -p 3000",
    "dev:gen:3000": "prisma generate && next dev --hostname 127.0.0.1 -p 3000",
    "dev:clean": "npm run clean && next dev",
    "dev:clean:3000": "npm run clean && next dev --hostname 127.0.0.1 -p 3000",
    "dev:clean:gen": "npm run clean && prisma generate && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "deploy:check": "prisma generate && npm run typecheck",
    "ops:deploy": "bash scripts/deploy-production.sh",
    "ops:deploy:pull": "bash scripts/deploy-from-image.sh",
    "ops:deploy:auto": "bash scripts/deploy-auto.sh",
    "ops:deploy:ghcr": "bash scripts/deploy-ghcr-only.sh",
    "ops:ghcr-login": "bash scripts/ghcr-login.sh",
    "ci:modules": "node scripts/ci/affected-modules.mjs",
    "ci:local": "npm run ci:modules && npm run lint && npm run deploy:check && npm run build",
    "setup:local": "node scripts/setup-local.mjs",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:fix-planilla-enum": "prisma db execute --file prisma/fix-expense-type-planilla.sql --schema prisma/schema.prisma",
    "db:fix-user-role-enum": "prisma db execute --file prisma/fix-user-role-enum.sql --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev",
    "db:seed": "ts-node prisma/seed/seed.ts",
    "db:seed-roles": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed-roles.ts",
    "db:seed-syntra": "node prisma/seed/seed-syntra-device.mjs",
    "db:reset-admin-passwords": "node prisma/tools/reset-admin-password.js",
    "db:clear-business": "ts-node prisma/tools/clear-business-data.ts",
    "db:clear-business:prod": "node prisma/tools/clear-business-data.mjs",
    "db:clear-disciplinary": "ts-node prisma/tools/clear-disciplinary-data.ts",
    "db:import-contracts": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/tools/import-contracts-from-xlsx.ts",
    "db:import-expenses": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/tools/import-expenses-from-xlsx.ts",
    "db:delete-cxc": "tsx scripts/db/delete-cxc-from-xlsx.ts",
    "db:mark-reajustes": "tsx scripts/db/mark-reajustes-from-xlsx.ts",
    "db:import-cxc-pj": "tsx scripts/db/import-pj-facturacion-cxc.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset"
  },
  "postinstall": "prisma generate",
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.2",
    "@hookform/resolvers": "^3.9.0",
    "@napi-rs/canvas": "^1.0.2",
    "@prisma/client": "^7.10.0",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.2",
    "@radix-ui/react-tooltip": "^1.1.4",
    "@tanstack/react-query": "^5.59.0",
    "@tanstack/react-table": "^8.20.5",
    "@types/node-forge": "^1.3.14",
    "@types/qrcode": "^1.5.6",
    "@xmldom/xmldom": "^0.8.13",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "imapflow": "^1.4.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.456.0",
    "mailparser": "^3.9.12",
    "mammoth": "^1.12.0",
    "next": "15.0.3",
    "next-auth": "^4.24.10",
    "node-forge": "^1.4.0",
    "nodemailer": "^7.0.13",
    "oracledb": "^7.0.0",
    "papaparse": "^5.5.4",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.4",
    "pdfjs-dist": "^5.6.205",
    "plotly.js-dist-min": "^3.7.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.2",
    "react-leaflet": "^4.2.1",
    "react-plotly.js": "^4.0.0",
    "recharts": "^2.13.3",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7",
    "xadesjs": "^2.6.7",
    "xlsx": "^0.18.5",
    "xmlbuilder2": "^4.0.3",
    "xmldsigjs": "^2.8.7",
    "xpath": "^0.0.34",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.21",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/papaparse": "^5.5.2",
    "@types/plotly.js": "^3.0.10",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.20",
    "eslint": "^8",
    "eslint-config-next": "15.0.3",
    "postcss": "^8",
    "prisma": "^7.10.0",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
