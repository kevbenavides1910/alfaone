  detalles          FeReciboPagoDetalle[]
  notasCredito      FeNotaCredito[]
  notasDebito       FeNotaDebito[]

  @@index([empresaId, estado])
  @@index([facturaReferenciaId])
  @@index([deletedAt])
  @@map("fe_recibos_pago")
}

model FeReciboPagoDetalle {
  id             String    @id @default(uuid()) @db.Uuid
  reciboPagoId   String    @db.Uuid
  numeroLinea    Int
  descripcion    String    @db.Text
  subTotal       Decimal   @db.Decimal(18, 5)
  tarifaImpuesto Decimal   @default(13) @db.Decimal(5, 2)
  montoImpuesto  Decimal   @default(0) @db.Decimal(18, 5)
  totalLinea     Decimal   @db.Decimal(18, 5)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  reciboPago FeReciboPago @relation(fields: [reciboPagoId], references: [id], onDelete: Cascade)

  @@unique([reciboPagoId, numeroLinea])
  @@index([reciboPagoId])
  @@map("fe_recibo_pago_detalles")
}

model FeEstadoHacienda {
  id              String                 @id @default(uuid()) @db.Uuid
  comprobanteId   String                 @db.Uuid
  estado          FeEstadoHaciendaCodigo
  codigoRespuesta String?
  mensaje         String?                @db.Text
  detalle         String?                @db.Text
  consultadoAt    DateTime               @default(now())
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  deletedAt       DateTime?

  comprobante FeComprobanteElectronico @relation(fields: [comprobanteId], references: [id], onDelete: Cascade)

  @@index([comprobanteId, consultadoAt])
  @@index([estado])
  @@map("fe_estados_hacienda")
}

model FeHistorialEnvio {
  id            String                    @id @default(uuid()) @db.Uuid
  comprobanteId String                    @db.Uuid
  operacion     FeHistorialEnvioOperacion
  resultado     FeHistorialEnvioResultado
  intento       Int                       @default(1)
  httpStatus    Int?
  duracionMs    Int?
  requestMeta   String?                   @db.Text
  responseMeta  String?                   @db.Text
  errorCode     String?
  errorMessage  String?                   @db.Text
  correlationId String?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  deletedAt     DateTime?

  comprobante FeComprobanteElectronico @relation(fields: [comprobanteId], references: [id], onDelete: Cascade)

  @@index([comprobanteId, createdAt])
  @@index([operacion, resultado])
  @@map("fe_historial_envios")
}

model FeAdjuntoXML {
  id            String          @id @default(uuid()) @db.Uuid
  comprobanteId String          @db.Uuid
  origen        FeAdjuntoOrigen
  storagePath   String
  fileName      String
  mimeType      String          @default("application/xml")
  sha256        String?         @db.VarChar(64)
  sizeBytes     Int?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  deletedAt     DateTime?

  comprobante FeComprobanteElectronico @relation(fields: [comprobanteId], references: [id], onDelete: Cascade)

  @@index([comprobanteId])
  @@map("fe_adjuntos_xml")
}

model FeAdjuntoPDF {
  id            String          @id @default(uuid()) @db.Uuid
  comprobanteId String          @db.Uuid
  origen        FeAdjuntoOrigen @default(GENERADO)
  storagePath   String
  fileName      String
  mimeType      String          @default("application/pdf")
  sha256        String?         @db.VarChar(64)
  sizeBytes     Int?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  deletedAt     DateTime?

  comprobante FeComprobanteElectronico @relation(fields: [comprobanteId], references: [id], onDelete: Cascade)

  @@index([comprobanteId])
  @@map("fe_adjuntos_pdf")
}

model FeAuditoria {
  id           String            @id @default(uuid()) @db.Uuid
  empresaId    String?           @db.Uuid
  entidad      String
  entidadId    String            @db.Uuid
  accion       FeAuditoriaAccion
  userId       String?
  previousData String?           @db.Text
  newData      String?           @db.Text
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  deletedAt    DateTime?

  empresa FeEmpresa? @relation(fields: [empresaId], references: [id], onDelete: SetNull)

  @@index([entidad, entidadId])
  @@index([empresaId, createdAt])
  @@map("fe_auditorias")
}

model FeJobQueue {
  id            String    @id @default(uuid()) @db.Uuid
  empresaId     String?   @db.Uuid
  comprobanteId String?   @db.Uuid
  jobType       FeJobTipo
  payload       String    @db.Text
  runAt         DateTime
  attempts      Int       @default(0)
  maxAttempts   Int       @default(5)
  lastError     String?   @db.Text
  lockedAt      DateTime?
  lockedBy      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  empresa     FeEmpresa?                @relation(fields: [empresaId], references: [id], onDelete: SetNull)
  comprobante FeComprobanteElectronico? @relation(fields: [comprobanteId], references: [id], onDelete: SetNull)

  @@index([runAt, jobType])
  @@index([comprobanteId])
  @@index([deletedAt])
  @@map("fe_job_queue")
}

// ─── Formularios — quizzes y encuestas editables ─────────────────────────────

enum FormQuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
  TEXT
}

model FormDefinition {
  id               String   @id @default(cuid())
  code             String   @unique
  title            String
  description      String?  @db.Text
  passScorePercent Int      @default(80)
  isActive         Boolean  @default(true)
  createdById      String?
  createdBy        User?    @relation("FormCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  questions   FormQuestion[]
  submissions FormSubmission[]

  @@map("form_definitions")
}

model FormQuestion {
  id               String           @id @default(cuid())
  formId           String
  form             FormDefinition   @relation(fields: [formId], references: [id], onDelete: Cascade)
  sortOrder        Int              @default(0)
  type             FormQuestionType
  text             String           @db.Text
  /// Para TRUE_FALSE: true = Verdadero es la respuesta correcta.
  correctTrueFalse Boolean?
  points           Int              @default(1)
  /// Si es crítica, fallarla impide aprobar aunque el puntaje global alcance el mínimo.
  isCritical       Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  options FormQuestionOption[]
  answers FormSubmissionAnswer[]

  @@index([formId, sortOrder])
  @@map("form_questions")
}

model FormQuestionOption {
  id         String       @id @default(cuid())
  questionId String
  question   FormQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  sortOrder  Int          @default(0)
  label      String       @db.Text
  isCorrect  Boolean      @default(false)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([questionId, sortOrder])
  @@map("form_question_options")
}

model FormSubmission {
  id           String         @id @default(cuid())
  formId       String
  form         FormDefinition @relation(fields: [formId], references: [id], onDelete: Cascade)
  userId       String
  user         User           @relation("FormSubmissionUser", fields: [userId], references: [id], onDelete: Restrict)
  scorePercent Int?
  passed       Boolean?
  submittedAt  DateTime       @default(now())

  answers FormSubmissionAnswer[]

  @@index([formId, submittedAt])
  @@index([userId])
  @@map("form_submissions")
}

model FormSubmissionAnswer {
  id           String         @id @default(cuid())
  submissionId String
  submission   FormSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  questionId   String
  question     FormQuestion   @relation(fields: [questionId], references: [id], onDelete: Restrict)
  /// { selectedOptionIds?: string[], trueFalse?: boolean, text?: string }
  answerJson   Json
  isCorrect    Boolean?

  @@index([submissionId])
  @@map("form_submission_answers")
}

// ─── Módulo Tickets TI (Help Desk / ITSM) ───────────────────────────────────

enum TicketSlaRecordStatus {
  ACTIVE
  PAUSED
  MET
  BREACHED
  CANCELLED
}

model TicketSequence {
  year       Int      @unique
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@map("ticket_sequences")
}

model TicketCategory {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?  @db.Text
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tickets Ticket[]

  @@map("ticket_categories")
}

model TicketPriority {
  id         String   @id @default(cuid())
  code       String   @unique
  name       String
  colorToken String   @default("blue")
  sortOrder  Int      @default(0)
  slaMinutes Int      @default(480)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tickets Ticket[]
  slas    TicketSla[]

  @@map("ticket_priorities")
}

model TicketStatus {
  id         String   @id @default(cuid())
  code       String   @unique
  name       String
  colorToken String   @default("slate")
  sortOrder  Int      @default(0)
  isTerminal Boolean  @default(false)
  pausesSla  Boolean  @default(false)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tickets Ticket[]

  @@map("ticket_statuses")
}

model TicketType {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets Ticket[]

  @@map("ticket_types")
}

model TicketDepartment {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets Ticket[]

  @@map("ticket_departments")
}

model TicketCloseReason {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets Ticket[]

  @@map("ticket_close_reasons")
}

model TicketTechnician {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ticket_technicians")
}

model Ticket {
  id               String             @id @default(cuid())
  ticketNumber     String             @unique
  title            String
  description      String             @db.Text
  categoryDetail   String?            @db.Text
  categoryId       String
  category         TicketCategory     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  priorityId       String
  priority         TicketPriority     @relation(fields: [priorityId], references: [id], onDelete: Restrict)
  statusId         String
  status           TicketStatus       @relation(fields: [statusId], references: [id], onDelete: Restrict)
  typeId           String
  type             TicketType         @relation(fields: [typeId], references: [id], onDelete: Restrict)
  departmentId     String?
  department       TicketDepartment?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  closeReasonId    String?
  closeReason      TicketCloseReason? @relation(fields: [closeReasonId], references: [id], onDelete: SetNull)
  requesterId      String
  requester        User               @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  assignedToId     String?
  assignedTo       User?              @relation("TicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  solution         String?            @db.Text
  totalWorkMinutes Int                @default(0)
  openedAt         DateTime           @default(now())
  assignedAt       DateTime?
  resolvedAt       DateTime?
  closedAt         DateTime?
  lastActivityAt   DateTime           @default(now())
  isLocked         Boolean            @default(false)
  lockReason       String?            @db.Text
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  deletedAt        DateTime?

  comments      TicketComment[]
  attachments   TicketAttachment[]
  histories     TicketHistory[]
  notifications TicketNotification[]
  audits        TicketAudit[]
  slas          TicketSla[]
  workLogs      TicketWorkLog[]

  @@index([statusId])
  @@index([requesterId])
  @@index([assignedToId])
  @@index([priorityId])
  @@index([lastActivityAt])
  @@map("tickets")
}

model TicketComment {
  id         String   @id @default(cuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation("TicketCommentAuthor", fields: [userId], references: [id], onDelete: Restrict)
  comment    String   @db.Text
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  attachments TicketAttachment[]

  @@index([ticketId, createdAt])
  @@map("ticket_comments")
}

model TicketAttachment {
  id           String         @id @default(cuid())
  ticketId     String
  ticket       Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  commentId    String?
  comment      TicketComment? @relation(fields: [commentId], references: [id], onDelete: SetNull)
  uploadedById String
  uploadedBy   User           @relation("TicketAttachmentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  originalName String
  storedName   String
  mimeType     String
  extension    String
  fileSize     Int
  disk         String         @default("local")
  path         String
  hash         String?
  createdAt    DateTime       @default(now())

  @@index([ticketId])
  @@map("ticket_attachments")
}

model TicketHistory {
  id          String   @id @default(cuid())
  ticketId    String
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  changedById String
  changedBy   User     @relation("TicketHistoryChanger", fields: [changedById], references: [id], onDelete: Restrict)
  field       String
  oldValue    String?  @db.Text
  newValue    String?  @db.Text
  reason      String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([ticketId, createdAt])
  @@map("ticket_histories")
}

model TicketNotification {
  id        String    @id @default(cuid())
  ticketId  String
  ticket    Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation("TicketNotificationUser", fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String    @db.Text
  type      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([ticketId])
  @@map("ticket_notifications")
}

model TicketAudit {
  id        String   @id @default(cuid())
  ticketId  String?
  ticket    Ticket?  @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  userId    String?
  user      User?    @relation("TicketAuditUser", fields: [userId], references: [id], onDelete: SetNull)
  action    String
  tableName String?
  recordId  String?
  oldValues Json?
  newValues Json?
  ip        String?
  browser   String?
  device    String?
  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
  @@index([userId, createdAt])
  @@map("ticket_audits")
}

model TicketSla {
  id               String                @id @default(cuid())
  ticketId         String
  ticket           Ticket                @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  priorityId       String
  priority         TicketPriority        @relation(fields: [priorityId], references: [id], onDelete: Restrict)
  targetMinutes    Int
  elapsedMinutes   Int                   @default(0)
  pausedMinutes    Int                   @default(0)
  remainingMinutes Int
  status           TicketSlaRecordStatus @default(ACTIVE)
  startedAt        DateTime              @default(now())
  pausedAt         DateTime?
  finishedAt       DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([ticketId])
  @@map("ticket_slas")
}

model TicketWorkLog {
  id           String    @id @default(cuid())
  ticketId     String
  ticket       Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  technicianId String
  technician   User      @relation("TicketWorkLogTechnician", fields: [technicianId], references: [id], onDelete: Restrict)
  startedAt    DateTime?
  finishedAt   DateTime?
  minutes      Int       @default(0)
  description  String?   @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([ticketId])
  @@map("ticket_work_logs")
}

// ─── Centro de notificaciones (plataforma) ───────────────────────────────────

model NotificationType {
  id             String               @id @default(cuid())
  code           String               @unique
  moduleKey      String
  label          String
  description    String?
  priority       NotificationPriority @default(INFO)
  icon           String?
  permissionKey  String?
  hrefTemplate   String?
  active         Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  roleRules      NotificationRoleRule[]
  preferences    NotificationPreference[]
  notifications  AppNotification[]

  @@index([moduleKey])
  @@map("notification_types")
}

model NotificationRoleRule {
  id                 String           @id @default(cuid())
  notificationTypeId String
  notificationType   NotificationType @relation(fields: [notificationTypeId], references: [id], onDelete: Cascade)
  roleCode           String
  minLevel           PermissionLevel  @default(VIEW)

  @@unique([notificationTypeId, roleCode])
  @@index([roleCode])
  @@map("notification_role_rules")
}

model AppNotification {
  id           String               @id @default(cuid())
  userId       String
  user         User                 @relation("AppNotificationUser", fields: [userId], references: [id], onDelete: Cascade)
  typeId       String
  type         NotificationType     @relation(fields: [typeId], references: [id], onDelete: Restrict)
  title        String
  body         String               @db.Text
  moduleKey    String
  entityType   String?
  entityId     String?
  href         String?
  priority     NotificationPriority
  status       NotificationStatus   @default(UNREAD)
  inboxVisible Boolean              @default(true)
  readAt       DateTime?
  archivedAt   DateTime?
  deletedAt    DateTime?
  metadata     Json?
  actorUserId  String?
  actorUser    User?                @relation("AppNotificationActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorIp      String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  auditLogs NotificationAuditLog[]

  @@index([userId, inboxVisible, status, createdAt(sort: Desc)])
  @@index([userId, status])
  @@index([createdAt])
  @@map("app_notifications")
}

model NotificationHistory {
  id             String   @id @default(cuid())
  notificationId String   @unique
  userId         String
  snapshot       Json
  movedAt        DateTime @default(now())

  @@index([userId, movedAt(sort: Desc)])
  @@map("notification_history")
}

model NotificationPreference {
  id                 String           @id @default(cuid())
  userId             String
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  notificationTypeId String
  notificationType   NotificationType @relation(fields: [notificationTypeId], references: [id], onDelete: Cascade)
  enabled            Boolean          @default(true)
  updatedAt          DateTime         @updatedAt

  @@unique([userId, notificationTypeId])
  @@map("notification_preferences")
}

model NotificationAuditLog {
  id             String           @id @default(cuid())
  notificationId String?
  notification   AppNotification? @relation(fields: [notificationId], references: [id], onDelete: SetNull)
  action         String
  userId         String?
  recipientId    String?
  moduleKey      String?
  actorIp        String?
  metadata       Json?
  createdAt      DateTime         @default(now())

  @@index([notificationId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("notification_audit_logs")
}
