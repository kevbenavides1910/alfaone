// ─── Módulo Ventas (pipeline de licitaciones) ─────────────────────────────────

enum VentasOportunidadEstado {
  PENDIENTE_DECIDIR
  PARTICIPAR
  NO_PARTICIPAR
}

/// Oportunidad de licitación detectada (p. ej. por automatización n8n) antes de convertirse en contrato.
model VentasOportunidad {
  id                 String                  @id @default(cuid())
  /// Número de licitación normalizado (único en el pipeline).
  licitacionNo       String                  @unique
  cliente            String
  descripcion        String                  @db.Text
  fechaPresentacion  DateTime
  enlace             String?
  /// Fecha/hora de inicio de recepción de ofertas (desde SICOP).
  inicioRecepcion    DateTime?
  /// Fecha/hora de cierre de recepción de ofertas (desde SICOP).
  cierreRecepcion    DateTime?
  /// Monto total estimado de la contratación en colones (desde SICOP).
  montoContratacion  Decimal?                @db.Decimal(18, 2)
  /// Moneda del monto de contratación (ej. CRC, USD).
  monedaContratacion String?
  /// Fecha/hora límite de recepción de aclaraciones (desde SICOP).
  fechaAclaracion    DateTime?
  /// Fecha/hora límite de recepción de objeciones (desde SICOP).
  fechaObjeciones    DateTime?
  /// Fecha de última actualización desde SICOP.
  sicopUpdatedAt     DateTime?
  estado             VentasOportunidadEstado @default(PENDIENTE_DECIDIR)
  /// Origen del registro (ej. "n8n").
  source             String?
  decidedAt          DateTime?
  decidedById        String?
  decidedBy          User?                   @relation("VentasOportunidadDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  presupuesto        VentasPresupuesto?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([estado])
  @@index([fechaPresentacion])
  @@index([cliente])
  @@map("ventas_oportunidades")
}

enum VentasSalarioTipo {
  MENSUAL
  HORARIO
}

enum VentasEquipamiento {
  AF
  ANL
  SA
  L
}

enum VentasPresupuestoEstado {
  BORRADOR
  EN_REVISION
  FINALIZADO
}

/// Catálogo de categorías salariales (hoja SALARIOS).
