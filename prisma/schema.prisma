/// Configuración FE del emisor — relación 1:1 con Company del ERP.
model FeEmpresa {
  id          String  @id @default(uuid()) @db.Uuid
  companyCode String  @unique
  company     Company @relation(fields: [companyCode], references: [code])

  nombreComercial    String
  razonSocial        String
  tipoIdentificacion FeIdentificacionTipo @default(JURIDICA)
  cedulaJuridica     String
  actividadEconomica String?

  /// Cédula del proveedor de sistemas (v4.4). Si vacío, se usa la cédula del emisor.
  proveedorSistemas String? @db.VarChar(20)
  /// Situación en clave numérica: 1=normal, 2=contingencia, 3=sin internet. Tribu usa 2.
  claveSituacion    String? @default("1") @db.VarChar(1)

  /// Si true, exige provincia/cantón/distrito del receptor al emitir.
  exigirUbicacionReceptor Boolean @default(true)

  ambiente FeAmbiente @default(STAGING)

  // ── Credenciales PRODUCCIÓN ────────────────────────────────────────────────
  certificadoPath        String?
  certificadoFileName    String?
  certificadoExpiresAt   DateTime?
  certificadoPasswordEnc String?   @db.Text

  /// Usuario ATV Hacienda producción.
  atvUsuario     String?
  atvPasswordEnc String? @db.Text

  // ── Credenciales STAGING (pruebas) ────────────────────────────────────────
  certificadoPathStg        String?
  certificadoFileNameStg    String?
  certificadoExpiresAtStg   DateTime?
  certificadoPasswordEncStg String?   @db.Text

  /// Usuario ATV Hacienda pruebas (ej. cpf-…@stag.comprobanteselectronicos.go.cr).
  atvUsuarioStg     String?
  atvPasswordEncStg String? @db.Text

  correoRemitente String?
  correoNombre    String?
  /// CC fijo en todos los correos de comprobantes (coma o punto y coma).
  correoCopiaFija String? @db.Text

  mailProvider String   @default("CUSTOM_SMTP") @db.VarChar(20)
  smtpHost     String?
  smtpPort     Int?
  smtpSecure   Boolean?
  smtpUser     String?
  smtpPass     String?
  smtpFrom     String?

  /// Buzón IMAP para facturas de proveedores (uno por empresa).
  imapEnabled      Boolean  @default(false)
  imapHost         String?
  imapPort         Int?     @default(993)
  imapSecure       Boolean? @default(true)
  imapUser         String?
  imapPass         String?
  imapFolder       String?  @default("INBOX")
  imapLastUid      Int?
  imapPuntoVentaId String?  @db.Uuid

  logoPath String?

  telefono           String?
  email              String?
  direccionProvincia String?
  direccionCanton    String?
  direccionDistrito  String?
  direccionBarrio    String?
  direccionOtras     String? @db.Text

  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  sucursales            FeSucursal[]
  clientes              FeCliente[]
  comprobantes          FeComprobanteElectronico[]
  facturas              FeFactura[]
  facturasCompra        FeFacturaCompra[]
  recibosPago           FeReciboPago[]
  mensajesReceptor      FeMensajeReceptor[]
  comprobantesRecibidos FeComprobanteRecibido[]
  gastosProveedor       FeGastoProveedor[]
  proveedoresConfianza  FeProveedorConfianza[]
  cabysFavoritos        FeCabysFavorito[]
  imapPuntoVenta        FePuntoVenta?              @relation("FeEmpresaImapPuntoVenta", fields: [imapPuntoVentaId], references: [id], onDelete: SetNull)
  auditorias            FeAuditoria[]
  jobs                  FeJobQueue[]

  @@index([deletedAt])
  @@index([ambiente])
  @@index([imapPuntoVentaId])
  @@map("fe_empresas")
}

model FeSucursal {
  id          String    @id @default(uuid()) @db.Uuid
  empresaId   String    @db.Uuid
  codigo      String    @db.VarChar(3)
  nombre      String
  telefono    String?
  direccion   String?   @db.Text
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  empresa     FeEmpresa      @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  puntosVenta FePuntoVenta[]

  @@unique([empresaId, codigo])
  @@index([empresaId])
  @@index([deletedAt])
  @@map("fe_sucursales")
}

model FePuntoVenta {
  id          String    @id @default(uuid()) @db.Uuid
  sucursalId  String    @db.Uuid
  codigo      String    @db.VarChar(5)
  nombre      String
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  sucursal         FeSucursal                 @relation(fields: [sucursalId], references: [id], onDelete: Restrict)
  consecutivos     FeConsecutivo[]
  comprobantes     FeComprobanteElectronico[]
  facturas         FeFactura[]
  facturasCompra   FeFacturaCompra[]
  recibosPago      FeReciboPago[]
  mensajesReceptor FeMensajeReceptor[]
  empresasImap     FeEmpresa[]                @relation("FeEmpresaImapPuntoVenta")

  @@index([sucursalId])
  @@index([deletedAt])
  @@map("fe_puntos_venta")
}

model FeConsecutivo {
  id              String            @id @default(uuid()) @db.Uuid
  puntoVentaId    String            @db.Uuid
  tipoComprobante FeComprobanteTipo
