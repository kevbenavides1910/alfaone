  @@map("ventas_indices_actualizacion")
}

/// Presupuesto de licitación vinculado a una oportunidad.
model VentasPresupuesto {
  id                String                       @id @default(cuid())
  oportunidadId     String?                      @unique
  oportunidad       VentasOportunidad?           @relation(fields: [oportunidadId], references: [id], onDelete: SetNull)
  licitacionNo      String
  compania          String
  nombre            String?
  anioBase          Int                          @default(2026)
  polizaInsPct      Decimal                      @default(5.75) @db.Decimal(8, 4)
  ivaPct            Decimal                      @default(13) @db.Decimal(8, 4)
  margenUtilidadPct Decimal                      @default(7) @db.Decimal(8, 4)
  imprevistosPct    Decimal                      @default(0.01) @db.Decimal(8, 4)
  estado            VentasPresupuestoEstado      @default(BORRADOR)
  totalMensual      Decimal?                     @db.Decimal(15, 2)
  totalAnual        Decimal?                     @db.Decimal(15, 2)
  totalConIva       Decimal?                     @db.Decimal(15, 2)
  estructuraResumen Json?
  /// Valores del catálogo modificados solo en este presupuesto (vs. parametrización general).
  catalogOverrides  Json?
  createdById       String?
  createdBy         User?                        @relation("VentasPresupuestoCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  lineas            VentasPresupuestoLinea[]
  tolerancia        VentasPresupuestoTolerancia?

  @@index([licitacionNo])
  @@index([estado])
  @@map("ventas_presupuestos")
}

/// Línea de detalle de presupuesto (hoja DETALLE).
model VentasPresupuestoLinea {
  id               String             @id @default(cuid())
  presupuestoId    String
  presupuesto      VentasPresupuesto  @relation(fields: [presupuestoId], references: [id], onDelete: Cascade)
  numeroLinea      String
  descripcion      String
  jornadaCodigo    String
  equipamiento     VentasEquipamiento
  cantidadPuestos  Int
  factorOficiales  Decimal            @default(1) @db.Decimal(8, 4)
  /// Hoja Excel de insumos (ej. 3,89AF-L) cuando varias variantes comparten eq+factor.
  codigoHojaInsumo String?
  costoMo          Decimal?           @db.Decimal(15, 2)
  costoGa          Decimal?           @db.Decimal(15, 2)
  costoInDirecto   Decimal?           @db.Decimal(15, 2)
  costoInIndirecto Decimal?           @db.Decimal(15, 2)
  imprevistos      Decimal?           @db.Decimal(15, 2)
  margenUtilidad   Decimal?           @db.Decimal(15, 2)
  precioMensual    Decimal?           @db.Decimal(15, 2)
  precioAnual      Decimal?           @db.Decimal(15, 2)
  precioConIva     Decimal?           @db.Decimal(15, 2)
  desglose         Json?
  sortOrder        Int                @default(0)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([presupuestoId])
  @@map("ventas_presupuesto_lineas")
}

/// Comparativo de tolerancia (oferta propia vs competencia).
model VentasPresupuestoTolerancia {
  id                String            @id @default(cuid())
  presupuestoId     String            @unique
  presupuesto       VentasPresupuesto @relation(fields: [presupuestoId], references: [id], onDelete: Cascade)
  ofertaPropia      Decimal?          @db.Decimal(15, 2)
  ofertaCompetencia Decimal?          @db.Decimal(15, 2)
  ofertaCliente     Decimal?          @db.Decimal(15, 2)
  observaciones     String?           @db.Text
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@map("ventas_presupuesto_tolerancia")
}

/// Parametrización general de presupuestos (valores por defecto para nuevos presupuestos).
model VentasPresupuestoConfig {
  id                String   @id @default("default")
  compania          String   @default("SEGURIDAD TANGO S.A")
  anioBase          Int      @default(2026)
  polizaInsPct      Decimal  @default(5.75) @db.Decimal(8, 4)
  ivaPct            Decimal  @default(13) @db.Decimal(8, 4)
  margenUtilidadPct Decimal  @default(7.523687797366793) @db.Decimal(12, 8)
  imprevistosPct    Decimal  @default(0.01) @db.Decimal(8, 4)
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())

  @@map("ventas_presupuesto_config")
}

