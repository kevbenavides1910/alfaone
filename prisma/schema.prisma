  deviceId     String?
  imei         String
  employeeCode String?
  pendingCount Int      @default(0)
  staleCount   Int      @default(0)
  appVersion   String?
  payload      Json
  createdAt    DateTime @default(now())

  @@index([imei, createdAt])
  @@map("patrol_device_pending_snapshots")
}

/// Punto GPS enviado desde app Alfa One.
model PatrolGpsTrack {
