// Esquema multi-módulo (monolito). Fronteras y convenciones: docs/ARCHITECTURE.md
// - core: Company, User, auth
// - presupuestos: Contract, Expense, ...
// - inventario: Asset*
// - disciplinario: Disciplinary*
// - plataforma: catálogos, AppBranding, AppDisciplinarySettings
// - sig: SigDocument*, procesos y tipos documentales (DMS)
// - formularios: FormDefinition*, quizzes y encuestas editables

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  SUPERVISOR
  COMPRAS
  COMMERCIAL
  CONSULTA
}

enum PermissionLevel {
  NONE
  VIEW
  EDIT
  ADMIN
}

enum NotificationPriority {
  INFO
  WARNING
  ERROR
  SUCCESS
  URGENT
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
  DELETED
}


enum ClientType {
  PUBLIC
  PRIVATE
}

enum ContractHiringType {
  FIXED
  ON_DEMAND
}

enum ContractStatus {
  ACTIVE
  PROLONGATION
  SUSPENDED
  FINISHED
  CANCELLED
}

enum FacturaMensualStatus {
  PENDIENTE_DEFINIR
  PENDIENTE
  EN_PROCESO
  FACTURADO
  COBRADO
}

enum FacturaReturnRequestStatus {
  PENDING
  REJECTED
}

enum FacturaCorrectionType {
  DOCUMENTATION
  AMOUNT
}

enum FacturaRequisitoStatus {
  PENDIENTE
  COMPLETADO
}

enum CxcDocumentoStatus {
  PENDIENTE
  COBRADO
}

enum ExpenseCategory {
  UNIFORMS
  AUDIT_FINDINGS
  DEFERRED
  ADMIN
  TRANSPORT
  FUEL
  PHONES
  OTHER
}

enum ExpenseType {
  APERTURA
  UNIFORMS
  AUDIT
  ADMIN
  TRANSPORT
  FUEL
  PHONES
  PLANILLA
  OTHER
}

/// Partida presupuestaria del gasto (distribución del contrato)
enum ExpenseBudgetLine {
  LABOR // Mano de obra
  SUPPLIES // Insumos
  ADMIN // Gasto administrativo
  PROFIT // Utilidad
}

enum ExpenseApprovalStatus {
  PENDING_APPROVAL
  PARTIALLY_APPROVED
  APPROVED
  REJECTED
}

enum ExpenseApprovalDecision {
  APPROVED
  REJECTED
}

enum AssetStatus {
  IN_STOCK
  ASSIGNED
  PENDING_RETURN
  RETIRED
}

enum AssetMovementType {
  INTAKE
  ISSUE
  ASSIGN
  RETURN
}

enum AssetIntakeReason {
  PURCHASE
  RETURN
  INITIAL
  OTHER
}

enum AssetIssueReason {
  LOST
  DAMAGED
  DISPOSED
  OTHER
}

// ─── Módulo disciplinario ──────────────────────────────────────────────────────

/// Estado registral del apercibimiento (lo que reporta la app de escritorio).
enum DisciplinaryStatus {
  EMITIDO
  ENTREGADO
  FIRMADO
  ANULADO
}

/// Vigencia recalculada por el servidor para asegurar consistencia entre clientes.
enum DisciplinaryVigencia {
  VIGENTE
  VENCIDO
  PRESCRITO
  FINALIZADO
  ANULADO
}

/// Acción registrada en un ciclo cerrado de tratamiento.
enum DisciplinaryCycleAccion {
  COBRADO
  DADO_DE_BAJA
  OTRO
}

// ─── Catálogo de empresas (código estable en mayúsculas, ej. ALFA) ─────────────

model Company {
  code      String   @id
  name      String
  /// Código numérico del sistema de planilla RRHH (ej. 01 = Alfa, 04 = Bena).
  sapCode   String?  @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users              User[]
  contracts          Contract[]
  deferredExpenses   DeferredExpense[]
  adminExpenses      AdminExpense[]
  expenses           Expense[]
  employees          Employee[]
  employeePlacements EmployeePlacement[]
  sigDocuments       SigDocument[]
  feEmpresa          FeEmpresa?

  @@map("companies")
}

// ─── Auth (NextAuth) ──────────────────────────────────────────────────────────

model Role {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model RolePermission {
  id            String          @id @default(cuid())
  roleId        String
  permissionKey String
  level         PermissionLevel @default(NONE)
  role          Role            @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionKey])
  @@index([permissionKey])
  @@map("role_permissions")
}

model User {
  id                     String    @id @default(cuid())
  name                   String
  email                  String    @unique
  emailVerified          DateTime?
  image                  String?
  passwordHash           String?
  role                   UserRole  @default(CONSULTA)
  roleId                 String?
  roleEntity             Role?     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  company                String?
  companyEntity          Company?  @relation(fields: [company], references: [code])
  isActive               Boolean   @default(true)
  mustChangePassword     Boolean   @default(false)
  passwordResetToken     String?
  passwordResetExpiresAt DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  accounts  Account[]
  sessions  Session[]
  auditLogs AuditLog[]
  expenses  Expense[]  @relation("ExpenseCreatedBy")

  expenseTypeApprovalSteps               ExpenseTypeApprovalStep[]     @relation("ExpenseTypeApprovalApprover")
  expenseApprovals                       ExpenseApproval[]             @relation("ExpenseApprovalApprover")
  expenseAttachments                     ExpenseAttachment[]           @relation("ExpenseAttachmentUploader")
  disciplinaryBatches                    DisciplinaryImportBatch[]     @relation("DisciplinaryBatchUploader")
  employeeImportBatches                  EmployeeImportBatch[]         @relation("EmployeeBatchUploader")
  sigDocumentsCreated                    SigDocument[]                 @relation("SigDocumentCreator")
  sigVersionsUploaded                    SigDocumentVersion[]          @relation("SigVersionUploader")
  sigVersionsApproved                    SigDocumentVersion[]          @relation("SigVersionApprover")
  sigVersionsAssigned                    SigDocumentVersion[]          @relation("SigVersionAssignedApprover")
  sigAuditLogs                           SigDocumentAuditLog[]         @relation("SigAuditActor")
  auditsCreated                          Audit[]                       @relation("AuditCreator")
  auditsAssigned                         Audit[]                       @relation("AuditAuditor")
  findingsCreated                        Finding[]                     @relation("FindingCreator")
  actionPlansCreated                     ActionPlan[]                  @relation("ActionPlanCreator")
  actionPlansResponsible                 ActionPlan[]                  @relation("ActionPlanResponsible")
  actionPlansEfficacyVerified            ActionPlan[]                  @relation("ActionPlanEfficacyVerifier")
  followUpsCreated                       FollowUp[]                    @relation("FollowUpCreator")
  checklistItemsReviewed                 AuditChecklistItem[]          @relation("AuditChecklistReviewer")
  sigEvidencesCreated                    SigEvidence[]                 @relation("SigEvidenceCreator")
  sigRequirementsCreated                 SigRequirement[]              @relation("SigRequirementCreator")
  sigControlsCreated                     SigControl[]                  @relation("SigControlCreator")
  sigControlsOwned                       SigControl[]                  @relation("SigControlOwner")
  sigRisksCreated                        SigRisk[]                     @relation("SigRiskCreator")
  sigRisksOwned                          SigRisk[]                     @relation("SigRiskOwner")
  sigLegalRequirementsCreated            SigLegalRequirement[]         @relation("SigLegalRequirementCreator")
  sigLegalRequirementsOwned              SigLegalRequirement[]         @relation("SigLegalRequirementOwner")
  sigIndicatorsCreated                   SigIndicator[]                @relation("SigIndicatorCreator")
  sigIndicatorsOwned                     SigIndicator[]                @relation("SigIndicatorOwner")
  sigIndicatorMeasurementsRecorded       SigIndicatorMeasurement[]     @relation("SigIndicatorMeasurementRecorder")
  auditProgramsCreated                   AuditProgram[]                @relation("AuditProgramCreator")
  auditProgramsApproved                  AuditProgram[]                @relation("AuditProgramApprover")
  auditProgramItemsAssigned              AuditProgramItem[]            @relation("AuditProgramItemAuditor")
  ventasOportunidadesDecididas           VentasOportunidad[]           @relation("VentasOportunidadDecidedBy")
  ventasPresupuestosCreados              VentasPresupuesto[]           @relation("VentasPresupuestoCreatedBy")
  facturasMensualesReturnedForCorrection FacturaMensual[]              @relation("FacturaReturnedForCorrection")
  facturaReturnRequestsSubmitted         FacturaMensual[]              @relation("FacturaReturnRequestedBy")
  facturaReturnRequestsReviewed          FacturaMensual[]              @relation("FacturaReturnReviewedBy")
  facturacionInvoiceModificationSettings AppFacturacionCobroSettings[] @relation("FacturacionInvoiceModifier")
  facturaEmisionNafLinks                 FacturaEmisionNafDocumento[]    @relation("FacturaEmisionNafLinkedBy")
  formsCreated                           FormDefinition[]              @relation("FormCreator")
  formSubmissions                        FormSubmission[]              @relation("FormSubmissionUser")

  ticketsRequested            Ticket[]             @relation("TicketRequester")
  ticketsAssigned             Ticket[]             @relation("TicketAssignee")
  ticketCommentsAuthored      TicketComment[]      @relation("TicketCommentAuthor")
  ticketAttachmentsUploaded   TicketAttachment[]   @relation("TicketAttachmentUploader")
  ticketHistoriesChanged      TicketHistory[]      @relation("TicketHistoryChanger")
  ticketNotificationsReceived TicketNotification[] @relation("TicketNotificationUser")
  appNotificationsReceived  AppNotification[]      @relation("AppNotificationUser")
  appNotificationsActed     AppNotification[]      @relation("AppNotificationActor")
  notificationPreferences NotificationPreference[]
  ticketAuditsPerformed       TicketAudit[]        @relation("TicketAuditUser")
  ticketWorkLogs              TicketWorkLog[]      @relation("TicketWorkLogTechnician")
  assetsDeleted               Asset[]              @relation("AssetDeletedBy")
  assetsUpdated               Asset[]              @relation("AssetUpdatedBy")
  expensesDeleted             Expense[]            @relation("ExpenseDeletedBy")
  expensesUpdated             Expense[]            @relation("ExpenseUpdatedBy")
  ticketTechnicianProfile     TicketTechnician?

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── Contracts ────────────────────────────────────────────────────────────────

model Contract {
  id                   String             @id @default(cuid())
  licitacionNo         String             @unique
  company              String
  companyEntity        Company            @relation(fields: [company], references: [code])
  client               String
  clientType           ClientType         @default(PUBLIC)
  /// Contratación fija (servicio continuo) o por demanda.
  hiringType           ContractHiringType @default(FIXED)
  officersCount        Int                @default(0)
  positionsCount       Int                @default(0)
  startDate            DateTime
  endDate              DateTime
  monthlyBilling       Decimal            @db.Decimal(15, 2)
  suppliesBudgetPct    Decimal            @db.Decimal(6, 4)
  equivalencePct       Decimal            @default(0) @db.Decimal(10, 8)
  // Budget distribution (% of monthlyBilling, should sum to ~1.0)
  laborPct             Decimal            @default(0) @db.Decimal(6, 4)
  suppliesPct          Decimal            @default(0) @db.Decimal(6, 4)
  adminPct             Decimal            @default(0) @db.Decimal(6, 4)
  profitPct            Decimal            @default(0) @db.Decimal(6, 4)
  /// Porcentaje de IVA aplicable (ej. 13.00 = 13 % en Costa Rica).
  ivaPct               Decimal            @default(13) @db.Decimal(5, 2)
  /// Día del mes (1–31) en que se espera emitir la factura.
  billingDay           Int                @default(1)
  /// Día de inicio del periodo de servicio que se factura (ej. 14 → del 14…).
  billingPeriodFromDay Int                @default(1)
  /// Día de cierre del periodo facturado; si es menor que fromDay, cae en el mes siguiente (ej. 1 → …al 1).
  billingPeriodToDay   Int                @default(31)
  /// Cantidad de facturas/documentos a emitir por mes en facturación.
  monthlyInvoicesCount Int                @default(1)
  /// Cantidad de administraciones del cliente que facturan por separado en este contrato.
  administrationsCount Int                @default(1)
  status               ContractStatus     @default(ACTIVE)
  notes                String?            @db.Text
  deletedAt            DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  createdById          String?
  updatedById          String?

  periods               ContractPeriod[]
  billingHistory        BillingHistory[]
  billingRequirements   ContractBillingRequirement[]
  specialServices       ContractSpecialService[]
  clientContacts        ContractClientContact[]
  uniformExpenses       UniformExpense[]
  auditFindings         AuditFinding[]
  deferredDistributions DeferredDistribution[]
  adminDistributions    AdminDistribution[]
  auditLogs             AuditLog[]
  expenses              Expense[]
  expenseDistributions  ExpenseDistribution[]        @relation("ExpenseDistributions")
  locations             ContractLocation[]
  employeePlacements    EmployeePlacement[]
  employeeContractLinks        EmployeeContractLink[]
  nafNominaManualAllocations   NafNominaManualAllocation[]
  monthLaborCaches             ContractMonthLaborCache[]
  patrolRoutes                 PatrolRoute[]
  demandBilling         ContractDemandBilling[]
  facturasMensuales     FacturaMensual[]
  cxcDocumentos         CxcDocumento[]
  billingLines          ContractBillingLine[]
  administrations       ContractAdministration[]

  @@index([company])
  @@index([status])
  @@index([deletedAt])
  @@index([endDate])
  @@map("contracts")
}

/// MO NAF precomputada por contrato/mes (evita Oracle en cada apertura del reporte mensual).
model ContractMonthLaborCache {
  id                  String   @id @default(cuid())
  contractId          String
  year                Int
  month               Int
  laborSpend          Decimal  @db.Decimal(18, 2)
  cargasSocialesSpend Decimal  @db.Decimal(18, 2)
  computedAt          DateTime @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([contractId, year, month])
  @@index([year, month])
  @@map("contract_month_labor_cache")
}

model BillingHistory {
  id             String   @id @default(cuid())
  contractId     String
  periodMonth    DateTime
  monthlyBilling Decimal  @db.Decimal(15, 2)
  notes          String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdById    String?

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([contractId, periodMonth])
  @@index([contractId])
  @@index([periodMonth])
  @@map("billing_history")
}

/// Monto a facturar por mes en contratos por demanda (solo ese mes, sin arrastre).
model ContractDemandBilling {
  id             String   @id @default(cuid())
  contractId     String
  periodYear     Int
  periodMonth    Int
  monthlyBilling Decimal  @db.Decimal(15, 2)
  notes          String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdById    String?

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([contractId, periodYear, periodMonth])
  @@index([contractId])
  @@index([periodYear, periodMonth])
  @@map("contract_demand_billing")
}

/// Requisitos documentales u operativos para facturar un contrato.
model ContractBillingRequirement {
  id               String   @id @default(cuid())
  contractId       String
  description      String
  notes            String?  @db.Text
  /// Si es true, en facturación debe adjuntarse un archivo; si es false, basta marcar cumplido.
  requiresEvidence Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createdById      String?

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@map("contract_billing_requirements")
}

/// Instantánea mensual de facturación por contrato (inmutable respecto al contrato vivo).
model FacturaMensual {
  id                             String                      @id @default(cuid())
  contractId                     String
  periodMonth                    Int
  periodYear                     Int
  expectedIssueDate              DateTime
  /// Fecha de vencimiento de la factura (editable; por defecto un mes después de la emisión).
  dueDate                        DateTime
  /// Última actualización del precio del contrato al momento de generar la factura.
  lastPriceUpdateCopied          DateTime
  status                         FacturaMensualStatus        @default(PENDIENTE)
  /// Fecha y hora en que se cerró la facturación (estado FACTURADO).
  closedAt                       DateTime?
  /// Fecha en que se confirmó recepción del pago (estado COBRADO).
  paidAt                         DateTime?
  /// Última vez que se registró revisión de pago (recibido o pendiente).
  lastPaymentReviewAt            DateTime?
  /// Último envío de correo de recordatorio por vencer (manual o automático).
  lastDueReminderEmailAt         DateTime?
  /// Último envío de correo de cobro por vencimiento (manual o automático).
  lastCollectionEmailAt          DateTime?
  /// Cantidad de correos de cobro enviados (solo tipo collection).
  collectionEmailCount           Int                         @default(0)
  /// Observaciones de gestión en cuentas por cobrar.
  cxcObservations                String?                     @db.Text
  /// Fecha esperada de pago acordada con el cliente (cuentas por cobrar).
  cxcExpectedPaymentDate         DateTime?
  /// Número o referencia del recibo provisional de pago parcial.
  provisionalReceiptNumber       String?
  /// Monto registrado en el recibo provisional (abono parcial).
  provisionalPaymentAmount       Decimal?                    @db.Decimal(15, 2)
  /// Número fiscal de la factura emitida al cliente.
  invoiceNumber                  String?
  /// Si es true, la factura se clasifica como reajuste (no facturación mensual regular).
  isReajuste                     Boolean                     @default(false)
  /// Número de documento asociado a la factura (referencia interna o del cliente).
  documentNumber                 String?
  /// Día de inicio del periodo de servicio copiado del contrato al generar la factura.
  billingPeriodFromDayCopied     Int                         @default(1)
  /// Día de cierre del periodo de servicio copiado del contrato al generar la factura.
  billingPeriodToDayCopied       Int                         @default(31)
  /// Inicio del periodo de servicio facturado (editable; si es null se calcula del contrato).
  servicePeriodFromDate          DateTime?
  /// Fin del periodo de servicio facturado (editable; si es null se calcula del contrato).
  servicePeriodToDate            DateTime?
  /// Fecha en que se recibió la factura por parte del cliente o área de cobro.
  invoiceReceivedAt              DateTime?
  finalNotes                     String?                     @db.Text
  observationLog                 String?                     @db.Text
  /// Subtotal (facturación mensual efectiva) copiado al generar.
  subtotalCopied                 Decimal                     @db.Decimal(15, 2)
  ivaPctCopied                   Decimal                     @db.Decimal(5, 2)
  totalCalculated                Decimal                     @db.Decimal(15, 2)
  clientNameCopied               String
  companyCodeCopied              String
  billingDayCopied               Int
  hiringTypeCopied               ContractHiringType          @default(FIXED)
  /// Cantidad de facturas/documentos copiada del contrato al generar la factura mensual.
  monthlyInvoicesCountCopied     Int                         @default(1)
  /// Veces regresada para corrección tras cierre (indica factura modificada).
  correctionReturnCount          Int                         @default(0)
  /// Última justificación al regresar la factura para corrección.
  lastCorrectionReason           String?                     @db.Text
  lastCorrectionReturnedAt       DateTime?
  lastCorrectionReturnedById     String?
  /// Subtotal antes del último cambio de monto aprobado.
  lastCorrectionPreviousSubtotal Decimal?                    @db.Decimal(15, 2)
  returnRequestStatus            FacturaReturnRequestStatus?
  returnRequestReason            String?                     @db.Text
  returnRequestRequestedAt       DateTime?
  returnRequestRequestedById     String?
  returnRequestReviewedAt        DateTime?
  returnRequestReviewedById      String?
  returnRequestReviewNote        String?                     @db.Text
  returnRequestType              FacturaCorrectionType?
  /// Subtotal solicitado en la solicitud de cambio de monto.
  returnRequestRequestedSubtotal Decimal?                    @db.Decimal(15, 2)
  returnRequestEvidencePath      String?
  returnRequestEvidenceFileName  String?
  returnRequestEvidenceMimeType  String?
  activeCorrectionType           FacturaCorrectionType?
  lastCorrectionType             FacturaCorrectionType?
  createdAt                      DateTime                    @default(now())
  updatedAt                      DateTime                    @updatedAt
  createdById                    String?

  contract                 Contract                @relation(fields: [contractId], references: [id], onDelete: Cascade)
  requisitos               FacturaRequisito[]
  emisiones                FacturaMensualEmision[]
  cxcDocumentos            CxcDocumento[]
  /// Vínculo opcional con facturas electrónicas (integración manual/futura).
  feFacturas               FeFactura[]
  lastCorrectionReturnedBy User?                   @relation("FacturaReturnedForCorrection", fields: [lastCorrectionReturnedById], references: [id], onDelete: SetNull)
  returnRequestRequestedBy User?                   @relation("FacturaReturnRequestedBy", fields: [returnRequestRequestedById], references: [id], onDelete: SetNull)
  returnRequestReviewedBy  User?                   @relation("FacturaReturnReviewedBy", fields: [returnRequestReviewedById], references: [id], onDelete: SetNull)

  @@unique([contractId, periodYear, periodMonth])
  @@index([periodYear, periodMonth])
  @@index([status])
  @@index([contractId])
  @@map("facturas_mensuales")
}

/// Emisión/documento fiscal asociado a una factura mensual (una por administración del contrato).
model FacturaMensualEmision {
  id                         String    @id @default(cuid())
  facturaMensualId           String
  sortOrder                  Int       @default(0)
  contractAdministrationId   String?
  administrationNameCopied   String?
  managerNameCopied          String?
  zoneNameCopied             String?
  /// Día de inicio del periodo facturado copiado de la administración/contrato.
  billingPeriodFromDayCopied Int?
  /// Día de cierre del periodo facturado copiado de la administración/contrato.
  billingPeriodToDayCopied   Int?
  invoiceNumber              String?
  documentNumber             String?
  invoiceReceivedAt          DateTime?
  /// Neto subtotal NAF ligado (FC/ND − NC/AN), snapshot recalculado al ligar/desligar.
  subtotalFacturadoNaf       Decimal?  @db.Decimal(15, 2)
  /// Neto total NAF ligado (con IVA), oficial para cierre/CxC.
  totalFacturadoNaf          Decimal?  @db.Decimal(15, 2)
  /// Fecha en que se cerró la facturación de esta administración.
  closedAt                   DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  facturaMensual         FacturaMensual               @relation(fields: [facturaMensualId], references: [id], onDelete: Cascade)
  contractAdministration ContractAdministration?      @relation(fields: [contractAdministrationId], references: [id], onDelete: SetNull)
  requisitos             FacturaRequisito[]
  nafDocumentos          FacturaEmisionNafDocumento[]

  @@unique([facturaMensualId, sortOrder])
  @@index([facturaMensualId])
  @@index([contractAdministrationId])
  @@map("factura_mensual_emisiones")
}

/// Documento NAF (ARFAFE) ligado a una emisión/administración de facturación mensual.
model FacturaEmisionNafDocumento {
  id                      String    @id @default(cuid())
  facturaMensualEmisionId String
  nafNoCia                String
  nafTipoDoc              String
  nafNoFactu              String
  nafNoFisico             String?
  nafSerieFisico          String?
  nafConsecutivoFe        String?
  nafClaveFactura         String?
  nafFecha                DateTime?
  subtotal                Decimal   @db.Decimal(15, 2)
  impuesto                Decimal   @db.Decimal(15, 2)
  total                   Decimal   @db.Decimal(15, 2)
  /// +1 FC/ND, -1 NC/AN
  amountSign              Int
  signedTotal             Decimal   @db.Decimal(15, 2)
  linkedAt                DateTime  @default(now())
  linkedById              String?

  emision  FacturaMensualEmision @relation(fields: [facturaMensualEmisionId], references: [id], onDelete: Cascade)
  linkedBy User?                 @relation("FacturaEmisionNafLinkedBy", fields: [linkedById], references: [id], onDelete: SetNull)

  @@unique([nafNoCia, nafTipoDoc, nafNoFactu])
  @@index([facturaMensualEmisionId])
  @@index([linkedById])
  @@map("factura_emision_naf_documentos")
}

/// Documento de cuentas por cobrar importado desde SAP (una fila por FC/FM).
model CxcDocumento {
  id                       String             @id @default(cuid())
  contractId               String?
  facturaMensualId         String?
  companySapCode           String
  companyCode              String?
  documentNumber           String
  invoiceNumber            String?
  repeats                  String?
  docType                  String
  documentDate             DateTime?
  /// Fecha en que el cliente recibió conforme la factura.
  invoiceReceivedAt        DateTime?
  servicePeriodDate        DateTime?
  montoOriginal            Decimal?           @db.Decimal(15, 2)
  saldo                    Decimal            @db.Decimal(15, 2)
  clientSapCode            String?
  clientName               String
  plazoDays                Int?
  diasVencido              Int?
  diasParaVencer           Int?
  montoVencido             Decimal?           @db.Decimal(15, 2)
  revisarDias              Int?
  dueDate                  DateTime?
  cxcExpectedPaymentDate   DateTime?
  provisionalReceiptNumber String?
  provisionalPaymentAmount Decimal?           @db.Decimal(15, 2)
  cxcObservations          String?            @db.Text
  status                   CxcDocumentoStatus @default(PENDIENTE)
  paidAt                   DateTime?
  lastPaymentReviewAt      DateTime?
  lastDueReminderEmailAt   DateTime?
  lastCollectionEmailAt    DateTime?
  collectionEmailCount     Int                @default(0)
  isReajuste               Boolean            @default(false)
  importSheet              String?
  importSheetRow           Int?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  contract       Contract?       @relation(fields: [contractId], references: [id], onDelete: SetNull)
  facturaMensual FacturaMensual? @relation(fields: [facturaMensualId], references: [id], onDelete: SetNull)
  rebajos        CxcRebajo[]
  abonos         CxcAbono[]

  @@unique([companySapCode, documentNumber])
  @@index([status])
  @@index([contractId])
  @@index([docType])
  @@index([dueDate])
  @@index([paidAt])
  @@index([cxcExpectedPaymentDate])
  @@index([docType, status, dueDate])
  @@index([isReajuste, docType, dueDate])
  @@map("cxc_documentos")
}

/// Rebajo o deducción manual en CxC (multas, ajustes del cliente, etc.).
model CxcRebajo {
  id             String   @id @default(cuid())
  cxcDocumentoId String
  description    String   @db.VarChar(500)
  amount         Decimal  @db.Decimal(15, 2)
  sortOrder      Int      @default(0)
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  cxcDocumento CxcDocumento @relation(fields: [cxcDocumentoId], references: [id], onDelete: Cascade)

  @@index([cxcDocumentoId])
  @@map("cxc_rebajos")
}

/// Abono parcial recibido en CxC (puede haber varios por documento).
model CxcAbono {
  id             String    @id @default(cuid())
  cxcDocumentoId String
  receiptNumber  String?   @db.VarChar(100)
  amount         Decimal   @db.Decimal(15, 2)
  paidAt         DateTime?
  sortOrder      Int       @default(0)
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  cxcDocumento CxcDocumento @relation(fields: [cxcDocumentoId], references: [id], onDelete: Cascade)

  @@index([cxcDocumentoId])
  @@map("cxc_abonos")
}

/// Requisito de entregable heredado del contrato para una factura mensual (por administración/emisión).
model FacturaRequisito {
  id                      String                 @id @default(cuid())
  facturaMensualId        String
  facturaMensualEmisionId String?
  requirementName         String
  status                  FacturaRequisitoStatus @default(PENDIENTE)
  /// Copiado del contrato: si requiere archivo adjunto o solo confirmación.
  requiresEvidenceCopied  Boolean                @default(true)
  filePath                String?
  fileName                String?
  mimeType                String?
  sortOrder               Int                    @default(0)
  uploadedAt              DateTime?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  facturaMensual FacturaMensual         @relation(fields: [facturaMensualId], references: [id], onDelete: Cascade)
  emision        FacturaMensualEmision? @relation(fields: [facturaMensualEmisionId], references: [id], onDelete: Cascade)

  @@index([facturaMensualId])
  @@index([facturaMensualEmisionId])
  @@map("factura_requisitos")
}

/// Servicios especiales facturados fuera de la facturación mensual base.
model ContractSpecialService {
  id          String   @id @default(cuid())
  contractId  String
  periodMonth DateTime
  description String
  amount      Decimal  @db.Decimal(15, 2)
  startDate   DateTime
  endDate     DateTime
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@index([contractId, periodMonth])
  @@map("contract_special_services")
}

/// Contactos del cliente asociados a un contrato.
model ContractClientContact {
  id               String   @id @default(cuid())
  contractId       String
  name             String
  jobTitle         String?
  isBillingContact Boolean  @default(false)
  isContractAdmin  Boolean  @default(false)
  phone            String
  phone2           String?
  email            String
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createdById      String?

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@map("contract_client_contacts")
}

/// Línea de facturación del contrato (código de partida / detalle presupuestario).
model ContractBillingLine {
  id            String   @id @default(cuid())
  contractId    String
  lineCode      String
  description   String
  monthlyAmount Decimal? @db.Decimal(15, 2)
  /// Si es true, el monto mensual de la línea lleva IVA según el % del contrato.
  appliesIva    Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdById   String?

  contract            Contract                            @relation(fields: [contractId], references: [id], onDelete: Cascade)
  administrationLinks ContractAdministrationBillingLine[]

  @@unique([contractId, lineCode])
  @@index([contractId])
  @@map("contract_billing_lines")
}

/// Unidad administrativa del cliente dentro de un contrato (encargado, zona, líneas).
model ContractAdministration {
  id                   String   @id @default(cuid())
  contractId           String
  name                 String
  managerName          String   @default("")
  managerEmail         String?
  managerPhone         String?
  zoneId               String?
  /// Si es null, hereda billingPeriodFromDay del contrato.
  billingPeriodFromDay Int?
  /// Si es null, hereda billingPeriodToDay del contrato.
  billingPeriodToDay   Int?
  sortOrder            Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  createdById          String?

  contract         Contract                            @relation(fields: [contractId], references: [id], onDelete: Cascade)
  zone             Zone?                               @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  billingLines     ContractAdministrationBillingLine[]
  facturaEmisiones FacturaMensualEmision[]

  @@index([contractId])
  @@index([zoneId])
  @@map("contract_administrations")
}

/// Asignación de líneas de facturación a una administración.
model ContractAdministrationBillingLine {
  administrationId String
  billingLineId    String
  /// Monto mensual de esta línea para esta administración (si null, usa monthlyAmount de la línea del contrato).
  monthlyAmount    Decimal? @db.Decimal(15, 2)

  administration ContractAdministration @relation(fields: [administrationId], references: [id], onDelete: Cascade)
  billingLine    ContractBillingLine    @relation(fields: [billingLineId], references: [id], onDelete: Cascade)

  @@id([administrationId, billingLineId])
  @@index([billingLineId])
  @@map("contract_administration_billing_lines")
}

model ContractPeriod {
  id             String   @id @default(cuid())
  contractId     String
  periodNumber   Int
  startDate      DateTime
  endDate        DateTime
  monthlyBilling Decimal  @db.Decimal(15, 2)
  notes          String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([contractId, periodNumber])
  @@index([contractId])
  @@map("contract_periods")
}

// ─── Uniform Expenses ─────────────────────────────────────────────────────────

model UniformExpense {
  id          String   @id @default(cuid())
  contractId  String
  periodMonth DateTime

  shirtQty  Int     @default(0)
  shirtCost Decimal @default(0) @db.Decimal(12, 2)
  pantsQty  Int     @default(0)
  pantsCost Decimal @default(0) @db.Decimal(12, 2)
  shoesQty  Int     @default(0)
  shoesCost Decimal @default(0) @db.Decimal(12, 2)
  capQty    Int     @default(0)
  capCost   Decimal @default(0) @db.Decimal(12, 2)
  vestQty   Int     @default(0)
  vestCost  Decimal @default(0) @db.Decimal(12, 2)
  beltQty   Int     @default(0)
  beltCost  Decimal @default(0) @db.Decimal(12, 2)
  bootsQty  Int     @default(0)
  bootsCost Decimal @default(0) @db.Decimal(12, 2)
  otherQty  Int     @default(0)
  otherCost Decimal @default(0) @db.Decimal(12, 2)
  otherDesc String?

  totalCost   Decimal  @default(0) @db.Decimal(15, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([contractId, periodMonth])
  @@index([contractId])
  @@index([periodMonth])
  @@map("uniform_expenses")
}

// ─── Audit Findings ───────────────────────────────────────────────────────────

model AuditFinding {
  id          String   @id @default(cuid())
  contractId  String
  postName    String
  findingDate DateTime @default(now())

  radioQty       Int     @default(0)
  radioCost      Decimal @default(0) @db.Decimal(12, 2)
  handcuffsQty   Int     @default(0)
  handcuffsCost  Decimal @default(0) @db.Decimal(12, 2)
  umbrellaQty    Int     @default(0)
  umbrellaCost   Decimal @default(0) @db.Decimal(12, 2)
  blackjackQty   Int     @default(0)
  blackjackCost  Decimal @default(0) @db.Decimal(12, 2)
  flashlightQty  Int     @default(0)
  flashlightCost Decimal @default(0) @db.Decimal(12, 2)
  otherQty       Int     @default(0)
  otherCost      Decimal @default(0) @db.Decimal(12, 2)
  otherDesc      String?

  totalCost   Decimal   @default(0) @db.Decimal(15, 2)
  status      String    @default("PENDING")
  resolvedAt  DateTime?
  notes       String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@index([findingDate])
  @@map("audit_findings")
}

// ─── Deferred Expenses ────────────────────────────────────────────────────────

model DeferredExpense {
  id            String          @id @default(cuid())
  company       String
  companyEntity Company         @relation(fields: [company], references: [code])
  description   String
  category      ExpenseCategory @default(OTHER)
  totalAmount   Decimal         @db.Decimal(15, 2)
  periodMonth   DateTime
  isDistributed Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  createdById   String?

  distributions DeferredDistribution[]

  @@index([company])
  @@index([company, periodMonth])
  @@map("deferred_expenses")
}

model DeferredDistribution {
  id                String   @id @default(cuid())
  deferredExpenseId String
  contractId        String
  equivalencePct    Decimal  @db.Decimal(5, 4)
  allocatedAmount   Decimal  @db.Decimal(15, 2)
  createdAt         DateTime @default(now())

  deferredExpense DeferredExpense @relation(fields: [deferredExpenseId], references: [id], onDelete: Cascade)
  contract        Contract        @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([deferredExpenseId, contractId])
  @@index([contractId])
  @@map("deferred_distributions")
}

// ─── Admin Expenses ───────────────────────────────────────────────────────────

model AdminExpense {
  id            String   @id @default(cuid())
  company       String
  companyEntity Company  @relation(fields: [company], references: [code])
  periodMonth   DateTime
  transport     Decimal  @default(0) @db.Decimal(15, 2)
  adminCosts    Decimal  @default(0) @db.Decimal(15, 2)
  phones        Decimal  @default(0) @db.Decimal(15, 2)
  phoneLines    Decimal  @default(0) @db.Decimal(15, 2)
  fuel          Decimal  @default(0) @db.Decimal(15, 2)
  otherAmount   Decimal  @default(0) @db.Decimal(15, 2)
  otherDesc     String?
  totalAmount   Decimal  @default(0) @db.Decimal(15, 2)
  isDistributed Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdById   String?

  distributions AdminDistribution[]

  @@unique([company, periodMonth])
  @@index([company])
  @@map("admin_expenses")
}

model AdminDistribution {
  id              String   @id @default(cuid())
  adminExpenseId  String
  contractId      String
  equivalencePct  Decimal  @db.Decimal(5, 4)
  allocatedAmount Decimal  @db.Decimal(15, 2)
  createdAt       DateTime @default(now())

  adminExpense AdminExpense @relation(fields: [adminExpenseId], references: [id], onDelete: Cascade)
  contract     Contract     @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([adminExpenseId, contractId])
  @@index([contractId])
  @@map("admin_distributions")
}

// ─── Audit Log ────────────────────────────────────────────────────────────────

model AuditLog {
  id           String   @id @default(cuid())
  userId       String
  contractId   String?
  entityType   String
  entityId     String
  action       String
  previousData String?  @db.Text
  newData      String?  @db.Text
  ipAddress    String?
  createdAt    DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id])
  contract Contract? @relation(fields: [contractId], references: [id])

  @@index([userId])
  @@index([contractId])
  @@index([createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ─── Unified Expenses ─────────────────────────────────────────────────────────

/// Zona geográfica/operativa que agrupa ubicaciones (ej. Pacífico, GAM, Caribe).
model Zone {
  id                             String                   @id @default(cuid())
  name                           String                   @unique
  description                    String?
  isActive                       Boolean                  @default(true)
  sortOrder                      Int                      @default(0)
  /// Administrador disciplinario por zona (misma lógica que zonas_admin del escritorio).
  disciplinaryAdministrator      String?
  disciplinaryAdministratorEmail String?
  createdAt                      DateTime                 @default(now())
  updatedAt                      DateTime                 @updatedAt
  locations                      ContractLocation[]
  administrations                ContractAdministration[]

  @@map("zones")
}

/// Ubicación física u operativa del contrato (contiene uno o más puestos).
model ContractLocation {
  id           String        @id @default(cuid())
  contractId   String
  contract     Contract      @relation(fields: [contractId], references: [id], onDelete: Cascade)
  zoneId       String?
  zone         Zone?         @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  name         String
  description  String?
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  positions    Position[]
  patrolRoutes PatrolRoute[]

  @@index([contractId])
  @@index([zoneId])
  @@map("contract_locations")
}

/// Puesto de vigilancia / guardia dentro de una ubicación.
model Position {
  id                 String             @id @default(cuid())
  locationId         String
  location           ContractLocation   @relation(fields: [locationId], references: [id], onDelete: Cascade)
  name               String
  description        String?
  /// Línea telefónica fija del puesto (independiente del celular físico asignado)
  phoneLine          String?
  /// Código NFC del punto de marca (legacy COD_PUNTO / TAG).
  nfcTagCode         String?            @unique
  latitude           Decimal?           @db.Decimal(10, 7)
  longitude          Decimal?           @db.Decimal(10, 7)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  expenses           Expense[]
  shifts             PositionShift[]
  assets             Asset[]            @relation("PositionAssets")
  assetMovementsFrom AssetMovement[]    @relation("AssetMovementFrom")
  assetMovementsTo   AssetMovement[]    @relation("AssetMovementTo")
  patrolRoutePoints  PatrolRoutePoint[]
  patrolRoutes       PatrolRoute[]

  @@index([locationId])
  @@map("positions")
}

/// Turno asociado a un puesto (horas distintas por turno).
model PositionShift {
  id         String   @id @default(cuid())
  positionId String
  position   Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  label      String?
  hours      Decimal  @db.Decimal(6, 2)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([positionId])
  @@map("position_shifts")
}

model ExpenseTypeConfig {
  id        String      @id @default(cuid())
  type      ExpenseType @unique
  label     String
  color     String      @default("bg-gray-100 text-gray-700")
  isActive  Boolean     @default(true)
  sortOrder Int         @default(0)
  updatedAt DateTime    @updatedAt

  @@map("expense_type_configs")
}

/// Cadena de aprobación por tipo de gasto (paso 1, luego 2, …). Usuarios concretos.
model ExpenseTypeApprovalStep {
  id             String      @id @default(cuid())
  expenseType    ExpenseType
  stepOrder      Int
  approverUserId String
  approver       User        @relation("ExpenseTypeApprovalApprover", fields: [approverUserId], references: [id], onDelete: Restrict)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([expenseType, stepOrder])
  @@index([expenseType])
  @@index([approverUserId])
  @@map("expense_type_approval_steps")
}

model ExpenseApproval {
  id             String                  @id @default(cuid())
  expenseId      String
  expense        Expense                 @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  stepOrder      Int
  approverUserId String
  approver       User                    @relation("ExpenseApprovalApprover", fields: [approverUserId], references: [id], onDelete: Restrict)
  decision       ExpenseApprovalDecision
  comment        String?                 @db.Text
  decidedAt      DateTime                @default(now())

  @@index([expenseId])
  @@index([approverUserId])
  @@map("expense_approvals")
}

model ExpenseAttachment {
  id           String   @id @default(cuid())
  expenseId    String
  expense      Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User     @relation("ExpenseAttachmentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  fileName     String
  mimeType     String
  storagePath  String
  note         String?  @db.Text
  createdAt    DateTime @default(now())

  @@index([expenseId])
  @@index([uploadedById])
  @@map("expense_attachments")
}

model ExpenseOrigin {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses Expense[]

  @@map("expense_origins")
}

model Expense {
  id                         String                @id @default(cuid())
  /// Consecutivo autoincremental único por gasto registrado
  sequentialNo               Int                   @unique @default(autoincrement())
  type                       ExpenseType
  budgetLine                 ExpenseBudgetLine?
  description                String
  amount                     Decimal               @db.Decimal(15, 2)
  periodMonth                DateTime
  contractId                 String?
  contract                   Contract?             @relation(fields: [contractId], references: [id])
  positionId                 String?
  position                   Position?             @relation(fields: [positionId], references: [id])
  originId                   String?
  origin                     ExpenseOrigin?        @relation(fields: [originId], references: [id])
  referenceNumber            String?
  company                    String?
  companyEntity              Company?              @relation(fields: [company], references: [code])
  isDeferred                 Boolean               @default(false)
  isDistributed              Boolean               @default(false)
  /// Contratos que reciben el reparto del diferido. Vacío = todos los ACTIVE/PROLONGATION.
  deferredIncludeContractIds String[]              @default([])
  /// Si true, el reparto usa `deferredManualAllocations` (montos fijos por contrato), no proporcional a insumos.
  deferredManualDistribution Boolean               @default(false)
  /// JSON: [{ "contractId": "…", "amount": 123.45 }, …]. Suma debe coincidir con `amount` del gasto.
  deferredManualAllocations  Json?
  notes                      String?
  /// Registro contable / CXP (texto libre)
  registroCxp                String?               @db.Text
  /// Registro TR (texto libre)
  registroTr                 String?               @db.Text
  approvalStatus             ExpenseApprovalStatus @default(APPROVED)
  /// Siguiente paso a aprobar (1-based), null si no aplica o flujo terminado
  currentApprovalStep        Int?
  requiredApprovalSteps      Int                   @default(0)
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt
  createdById                String
  createdBy                  User                  @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  /// Soft-delete: el registro permanece para auditoría; no aparece en listados operativos.
  deletedAt                  DateTime?
  deletedById                String?
  deletedBy                  User?                 @relation("ExpenseDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  updatedById                String?
  updatedBy                  User?                 @relation("ExpenseUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  distributions              ExpenseDistribution[]
  approvals                  ExpenseApproval[]
  attachments                ExpenseAttachment[]
  assetsAcquired             Asset[]               @relation("AssetAcquisitionExpense")
  assetMovements             AssetMovement[]       @relation("AssetMovementExpense")

  @@index([contractId])
  @@index([positionId])
  @@index([originId])
  @@index([company])
  @@index([approvalStatus])
  @@index([company, periodMonth])
  @@index([company, approvalStatus])
  @@index([deletedAt])
  @@map("expenses")
}

model ExpenseDistribution {
  id              String   @id @default(cuid())
  expenseId       String
  expense         Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  contractId      String
  contract        Contract @relation("ExpenseDistributions", fields: [contractId], references: [id], onDelete: Cascade)
  equivalencePct  Decimal  @db.Decimal(10, 8)
  allocatedAmount Decimal  @db.Decimal(15, 2)
  createdAt       DateTime @default(now())

  @@unique([expenseId, contractId])
  @@index([contractId])
  @@map("expense_distributions")
}

// ─── Assets / Inventario ──────────────────────────────────────────────────────

/// Catálogo editable de tipos de activos (celular, arma, radio, …).
/// Cada tipo declara qué campos extra se piden a los activos de ese tipo.
model AssetType {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  /// JSON: array de { key, label, type: "string"|"number"|"date"|"boolean", required }
  fields    Json     @default("[]")
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assets Asset[]

  @@map("asset_types")
}

/// Activo individual (cada unidad física identificable).
model Asset {
  id                   String      @id @default(cuid())
  typeId               String
  type                 AssetType   @relation(fields: [typeId], references: [id], onDelete: Restrict)
  /// Identificador único dentro del tipo (ej. serial, código interno).
  code                 String
  name                 String?
  brand                String?
  model                String?
  /// Valores para los campos declarados en AssetType.fields (ej. { imei, numero, calibre }).
  attributes           Json        @default("{}")
  status               AssetStatus @default(IN_STOCK)
  currentPositionId    String?
  currentPosition      Position?   @relation("PositionAssets", fields: [currentPositionId], references: [id], onDelete: SetNull)
  acquisitionExpenseId String?
  acquisitionExpense   Expense?    @relation("AssetAcquisitionExpense", fields: [acquisitionExpenseId], references: [id], onDelete: SetNull)
  acquisitionDate      DateTime?
  notes                String?     @db.Text
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  /// Soft-delete: el activo permanece en BD con historial de movimientos intacto.
  deletedAt            DateTime?
  deletedById          String?
  deletedBy            User?       @relation("AssetDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  updatedById          String?
  updatedBy            User?       @relation("AssetUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  movements AssetMovement[]

  @@unique([typeId, code])
  @@index([status])
  @@index([currentPositionId])
  @@index([typeId])
  @@index([deletedAt])
  @@map("assets")
}

/// Historial inmutable de movimientos de un activo (solo INSERT, nunca UPDATE/DELETE).
model AssetMovement {
  id             String             @id @default(cuid())
  assetId        String
  asset          Asset              @relation(fields: [assetId], references: [id], onDelete: Cascade)
  type           AssetMovementType
  fromPositionId String?
  fromPosition   Position?          @relation("AssetMovementFrom", fields: [fromPositionId], references: [id], onDelete: SetNull)
  toPositionId   String?
  toPosition     Position?          @relation("AssetMovementTo", fields: [toPositionId], references: [id], onDelete: SetNull)
  expenseId      String?
  expense        Expense?           @relation("AssetMovementExpense", fields: [expenseId], references: [id], onDelete: SetNull)
  intakeReason   AssetIntakeReason?
  issueReason    AssetIssueReason?
  notes          String?            @db.Text
  createdById    String?
  createdAt      DateTime           @default(now())

  @@index([assetId])
  @@index([type])
  @@index([createdAt])
  @@map("asset_movements")
}

// ─── Módulo disciplinario ──────────────────────────────────────────────────────

/// Lote de importación de Excel (auditoría: quién subió, cuántas filas).
model DisciplinaryImportBatch {
  id              String   @id @default(cuid())
  filename        String
  /// SHA-256 del contenido del archivo subido. Se usa para detectar archivos
  /// repetidos (byte a byte) y rechazarlos sin reprocesarlos. Unique.
  checksum        String?  @unique
  uploadedById    String
  uploadedBy      User     @relation("DisciplinaryBatchUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  rowsHistorial   Int      @default(0)
  rowsTratamiento Int      @default(0)
  rowsInserted    Int      @default(0)
  rowsUpdated     Int      @default(0)
  rowsSkipped     Int      @default(0)
  errorsJson      Json?
  notes           String?  @db.Text
  createdAt       DateTime @default(now())

  apercibimientos DisciplinaryApercibimiento[]
  tratamientos    DisciplinaryTreatment[]

  @@index([createdAt])
  @@map("disciplinary_import_batches")
}

/// Una fila por apercibimiento emitido (importado desde el Excel de la app de escritorio).
model DisciplinaryApercibimiento {
  id                 String               @id @default(cuid())
  /// N° de apercibimiento (texto, único por sistema).
  numero             String               @unique
  fechaEmision       DateTime
  /// Código del empleado normalizado (trim + sin ceros a la izquierda si es numérico).
  codigoEmpleado     String
  /// Código tal cual vino en el Excel original (para trazabilidad).
  codigoEmpleadoRaw  String?
  nombreEmpleado     String
  zona               String?
  sucursal           String?
  cantidadOmisiones  Int                  @default(0)
  administrador      String?
  /// Correo al que se envió el apercibimiento. Sensible: no exponer en UI normal.
  correoEnviadoA     String?
  /// Ruta interna al PDF en el equipo de la app de escritorio. Sensible: no exponer.
  rutaPdf            String?
  estado             DisciplinaryStatus   @default(EMITIDO)
  /// Vigencia recalculada en el servidor según fechaEmision + estado.
  vigencia           DisciplinaryVigencia @default(VIGENTE)
  batchExterno       String?
  plantilla          String?
  planoOrigen        String?
  motivoAnulacion    String?              @db.Text
  /// Texto/ruta de la evidencia de anulación. Sensible.
  evidenciaAnulacion String?              @db.Text

  /// Contrato/Licitación tal cual vino en el Excel (para trazabilidad).
  contrato            String?
  /// Versión normalizada (uppercase, sin espacios extra) usada para emparejar con `Contract.licitacionNo`.
  contratoNormalizado String?
  /// Cliente resuelto a partir del contrato (o editado a mano en la web).
  cliente             String?
  /// True cuando el cliente fue editado manualmente desde la web; protege re-imports incrementales.
  clienteSetManual    Boolean @default(false)

  /// Firma dibujada del oficial en «Recibido por» (ruta relativa bajo evidencia disciplinaria).
  firmaRecibidoPath      String?
  firmaRecibidoAt        DateTime?
  correoFirmadoEnviadoAt DateTime?

  importBatchId String?
  importBatch   DisciplinaryImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Fechas de las omisiones de marca que generaron este apercibimiento.
  /// Una sola celda del Excel puede traer varias fechas (separadas por , ; | o saltos de línea).
  omisiones DisciplinaryOmission[]

  @@index([codigoEmpleado, fechaEmision])
  @@index([fechaEmision])
  @@index([administrador])
  @@index([estado])
  @@index([vigencia])
  @@index([contratoNormalizado])
  @@map("disciplinary_apercibimientos")
}

/// Cada omisión de marca individual asociada a un apercibimiento. N filas por apercibimiento.
/// Importante: un mismo día puede tener varias omisiones (ej.: entrada y salida no marcadas),
/// por lo que NO se deduplica por (apercibimiento, fecha). Cada ítem reportado en la celda
/// "Fecha de Omisión" del Excel se guarda como una fila independiente preservando la cardinalidad.
/// Se usa para el reporte de omisiones por periodo, independiente de la `fechaEmision`.
model DisciplinaryOmission {
  id               String                     @id @default(cuid())
  apercibimientoId String
  apercibimiento   DisciplinaryApercibimiento @relation(fields: [apercibimientoId], references: [id], onDelete: Cascade)
  fecha            DateTime
  /// Hora de la omisión en formato "HH:mm" o "HH:mm:ss" (texto, sin timezone).
  /// Permite distinguir varias omisiones del mismo día (ej.: entrada vs salida)
  /// sin riesgos de conversión horaria. Puede venir vacío si el Excel solo trae fecha.
  hora             String?
  /// Lugar / dispositivo / punto de marca omitido (columna del Excel de importación).
  puntoOmitido     String?                    @db.VarChar(500)
  /// Posición ordinal dentro de la celda original (para mantener orden y distinguir duplicados del mismo día).
  secuencia        Int                        @default(0)
  createdAt        DateTime                   @default(now())

  @@index([apercibimientoId, fecha])
  @@index([fecha])
  @@map("disciplinary_omisiones")
}

/// Maestro de empleados para disciplinario (CSV RRHH u otros; correo para envío de apercibimientos).
model DisciplinaryEmployeeMaster {
  id                 String   @id @default(cuid())
  codigoEmpleado     String   @unique
  codigoEmpleadoRaw  String?
  nombre             String?
  /// Número de cédula / identificación (para PDF y reportes).
  cedula             String?
  email              String?
  zona               String?
  telefono           String?
  cuentaBancaria     String?  @db.Text
  extra              Json?
  lastSourceFilename String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([updatedAt])
  @@map("disciplinary_employee_master")
}

/// Estado vigente de tratamiento por empleado (1 fila por código).
model DisciplinaryTreatment {
  id                    String    @id @default(cuid())
  codigoEmpleado        String    @unique
  codigoEmpleadoRaw     String?
  nombre                String?
  zona                  String?
  fechaConvocatoria     DateTime?
  /// Hora local de la convocatoria (HH:MM, 24 h).
  horaConvocatoria      String?
  accion                String?
  cobradoDate           DateTime?
  convocatoriaEnviadaAt DateTime?

  importBatchId String?
  importBatch   DisciplinaryImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  closedCycles DisciplinaryClosedCycle[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([codigoEmpleado])
  @@map("disciplinary_treatments")
}

/// Ciclos cerrados (parsing del closed_cycles_json del Excel).
model DisciplinaryClosedCycle {
  id                String                  @id @default(cuid())
  treatmentId       String
  treatment         DisciplinaryTreatment   @relation(fields: [treatmentId], references: [id], onDelete: Cascade)
  cerradoEl         DateTime?
  accion            DisciplinaryCycleAccion @default(OTRO)
  accionRaw         String?
  monto             Decimal?                @db.Decimal(14, 2)
  count             Int?
  omissions         Int?
  lastDate          DateTime?
  fechaConvocatoria DateTime?
  nombre            String?
  zona              String?
  raw               Json

  @@index([treatmentId])
  @@index([cerradoEl])
  @@index([accion])
  @@map("disciplinary_closed_cycles")
}

// ─── Módulo empleados (RRHH) ───────────────────────────────────────────────────

/// Lote de importación CSV de empleados (auditoría).
model EmployeeImportBatch {
  id                   String   @id @default(cuid())
  filename             String
  checksum             String?  @unique
  uploadedById         String
  uploadedBy           User     @relation("EmployeeBatchUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  rowsProcessed        Int      @default(0)
  employeesUpserted    Int      @default(0)
  placementsUpserted   Int      @default(0)
  rowsSkipped          Int      @default(0)
  employeesDeactivated Int      @default(0)
  errorsJson           Json?
  createdAt            DateTime @default(now())

  employees  Employee[]
  placements EmployeePlacement[]

  @@index([createdAt])
  @@map("employee_import_batches")
}

/// Maestro de empleados (datos personales, bancarios y nómina).
model Employee {
  id                 String               @id @default(cuid())
  codigoEmpleado     String               @unique
  codigoEmpleadoRaw  String?
  nombre             String?
  cedula             String?
  /// Cédula normalizada (solo dígitos) para cruce en importaciones.
  cedulaNormalizada  String?
  aseguradora        String?
  email              String?
  telefono           String?
  fechaNacimiento    DateTime?
  direccion          String?              @db.Text
  sexo               String?
  oficial            Boolean              @default(false)
  /// Estado del CSV (ej. A = activo).
  estado             String?
  formaPago          String?
  tipoCuenta         String?
  numeroCuenta       String?
  tituloCode         String?
  tituloNombre       String?
  clase              String?
  nominaCode         String?
  nominaNombre       String?
  fechaIngreso       DateTime?
  centroCosto        String?
  categoria          String?
  zona               String?
  /// Código numérico de compañía del sistema de planilla (ej. 04, 06).
  companySapCode     String?
  /// Código del catálogo de empresas (ej. ALFA, BENA) vinculado vía sapCode.
  company            String?
  companyEntity      Company?             @relation(fields: [company], references: [code])
  lastImportBatchId  String?
  lastImportBatch    EmployeeImportBatch? @relation(fields: [lastImportBatchId], references: [id], onDelete: SetNull)
  lastSourceFilename String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  placements EmployeePlacement[]

  @@index([nombre])
  @@index([cedula])
  @@index([cedulaNormalizada])
  @@index([zona])
  @@index([estado])
  @@index([companySapCode])
  @@index([company])
  @@map("employees")
}

/// Asignación de empleado a contrato / ubicación / puesto (una fila del CSV).
model EmployeePlacement {
  id                  String               @id @default(cuid())
  employeeId          String
  employee            Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  companySapCode      String?
  company             String?
  companyEntity       Company?             @relation(fields: [company], references: [code])
  contrato            String?
  contratoNormalizado String?
  contractId          String?
  contract            Contract?            @relation(fields: [contractId], references: [id], onDelete: SetNull)
  ubicacionCode       String?
  ubicacionNombre     String?
  puestoNombre        String?
  noRol               String?
  zona                String?
  importBatchId       String?
  importBatch         EmployeeImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@unique([employeeId, contratoNormalizado, ubicacionCode, noRol])
  @@index([employeeId])
  @@index([contractId])
  @@index([contratoNormalizado])
  @@index([ubicacionCode])
  @@map("employee_placements")
}

/// Vínculo persistente entre número de contrato del RRHH y contrato del módulo presupuestos.
model EmployeeContractLink {
