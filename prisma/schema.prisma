  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  assignments PatrolAssignment[]

  @@index([employeeCode])
  @@map("patrol_devices")
}

/// Ruta de recorrido configurable desde presupuestos.
model PatrolRoute {
  id                      String            @id @default(cuid())
  code                    String            @unique
  name                    String
  description             String?
  contractId              String?
  contract                Contract?         @relation(fields: [contractId], references: [id], onDelete: SetNull)
  locationId              String?
  location                ContractLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  positionId              String?
  position                Position?         @relation(fields: [positionId], references: [id], onDelete: SetNull)
  isActive                Boolean           @default(true)
  openSchedule            Boolean           @default(false)
  scheduleDurationMinutes Int?
  sameScheduleEveryDay    Boolean           @default(true)
  samePointsEveryDay      Boolean           @default(true)
  randomizePointOrder     Boolean           @default(false)
  welfareEnabled          Boolean           @default(false)
  welfareIntervalMinutes  Int               @default(60)
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  points           PatrolRoutePoint[]
  pointDays        PatrolRoutePointDay[]
  assignments      PatrolAssignment[]
  authorizedPhones PatrolRoutePhone[]
  schedules        PatrolRouteSchedule[]
  welfareChecks    PatrolWelfareCheck[]

  @@map("patrol_routes")
}

/// Celular autorizado para ejecutar una ruta (principal o adicional).
model PatrolRoutePhone {
  id        String      @id @default(cuid())
  routeId   String
  route     PatrolRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  assetId   String
  isPrimary Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([routeId, assetId])
  @@index([routeId])
  @@map("patrol_route_phones")
}

/// Franja horaria de una ruta por día de la semana (0=domingo … 6=sábado).
model PatrolRouteSchedule {
  id        String      @id @default(cuid())
  routeId   String
  route     PatrolRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  startTime String
  endTime   String
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([routeId])
  @@index([routeId, dayOfWeek])
  @@map("patrol_route_schedules")
}

/// Registro de alerta de hombre vivo (programada o manual).
model PatrolWelfareCheck {
  id             String      @id @default(cuid())
  routeId        String
  route          PatrolRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  deviceId       String?
  imei           String
  source         String      @default("MANUAL")
  status         String      @default("PENDING")
  scheduledAt    DateTime    @default(now())
  triggeredAt    DateTime?
  acknowledgedAt DateTime?
  ackLatitude    Decimal?    @db.Decimal(10, 7)
  ackLongitude   Decimal?    @db.Decimal(10, 7)
  createdAt      DateTime    @default(now())

  @@index([routeId])
  @@index([imei, status])
  @@map("patrol_welfare_checks")
}

/// Punto de marca dentro de una ruta (NFC, coords, ventana horaria).
model PatrolRoutePoint {
  id          String      @id @default(cuid())
  routeId     String
  route       PatrolRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  sortOrder   Int         @default(0)
  code        String
  name        String
  nfcTagCode  String?
  latitude    Decimal?    @db.Decimal(10, 7)
  longitude   Decimal?    @db.Decimal(10, 7)
  radiusM     Int         @default(100)
  windowStart String?
  windowEnd   String?
  positionId  String?
  position    Position?   @relation(fields: [positionId], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  pointDays PatrolRoutePointDay[]

  @@index([routeId])
  @@index([nfcTagCode])
  @@map("patrol_route_points")
}

/// Punto de marca activo en un día de la semana (0=domingo … 6=sábado).
model PatrolRoutePointDay {
  id        String           @id @default(cuid())
  routeId   String
  route     PatrolRoute      @relation(fields: [routeId], references: [id], onDelete: Cascade)
  pointId   String
  point     PatrolRoutePoint @relation(fields: [pointId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([pointId, dayOfWeek])
  @@index([routeId])
  @@index([routeId, dayOfWeek])
  @@map("patrol_route_point_days")
}

/// Asignación dispositivo ↔ ruta por fecha.
model PatrolAssignment {
  id         String       @id @default(cuid())
  deviceId   String
  device     PatrolDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  routeId    String
  route      PatrolRoute  @relation(fields: [routeId], references: [id], onDelete: Cascade)
  validFrom  DateTime     @db.Date
  validUntil DateTime?    @db.Date
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([deviceId, routeId, validFrom])
  @@index([deviceId])
  @@index([routeId])
  @@map("patrol_assignments")
}

/// Entrada de bitácora digital (app o web).
model PatrolBitacoraEntry {
