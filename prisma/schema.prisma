  ubicacion    String
  dia          String?
  fecha        DateTime
  horaApertura String?
  horaCierre   String?
  operadorName String
  estado       String?

  @@index([fecha])
  @@index([codigo])
  @@map("bandeco_aperturas_cierres")
}

/// Informes de eventos (hoja EVENTOS).
model BandecoEvento {
  id           String   @id @default(cuid())
  fecha        DateTime
  hora         String?
  finca        String
  motivo       String?
  informe      String   @db.Text
  operadorName String
  imagenes     Json?
  createdAt    DateTime @default(now())

  @@index([fecha])
  @@map("bandeco_eventos")
}

// ─── Módulo Empleados NAF (réplica local Oracle NAF5.EMPLEADOS_NEW) ───────────

/// Ejecución de sincronización desde Oracle NAF.
model NafEmployeeSyncRun {
  id           String    @id @default(cuid())
  status       String
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  rowsFetched  Int       @default(0)
  rowsUpserted Int       @default(0)
  errorMessage String?   @db.Text
  triggeredBy  String?

  @@index([startedAt])
  @@map("naf_employee_sync_runs")
}

/// Empleado replicado del maestro NAF (NAF5.EMPLEADOS_NEW).
model NafEmployee {
  id                String    @id @default(cuid())
  /// Clave compuesta NO_CIA + NO_EMPLE (normalizada).
  sourceKey         String    @unique
  noCia             String
  noEmple           String
  nombre            String?
  nombrePila        String?
  apePat            String?
  apeMat            String?
  estado            String?
  cedula            String?
  telefono          String?
  correoElectronico String?
  area              String?
  depto             String?
  puesto            String?
  sexo              String?
  formaPago         String?
  numCuenta         String?
  tipoCuenta        String?
  banco             String?
  tipoEmp           String?
  contrato          String?
  ubicacionCode     String?
  ubicacionNombre   String?
  asegu             String?
  noRol             String?
  tituloCode        String?
  tituloNombre      String?
  categoria         String?
  clase             String?
  nominaCode        String?
  nominaNombre      String?
  indOficial        String?
  fIngreso          DateTime?
  fEgreso           DateTime?
  fNacimi           DateTime?
  direccion         String?   @db.Text
  zonaCode          String?
  zona              String?
  eCivil            String?
  jornada           String?
  nacion            String?
  salBas            Decimal?  @db.Decimal(14, 2)
  /// Fila completa de Oracle (84 columnas) en JSON.
  payload           Json
  syncedAt          DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([nombre])
  @@index([cedula])
  @@index([estado])
  @@index([noCia])
  @@index([syncedAt])
  @@map("naf_employees")
}

/// Corrida de sincronización del histórico de nómina NAF (NAF5.ARPLHS).
model NafNominaSyncRun {
  id           String    @id @default(cuid())
  status       String
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  rowsFetched  Int       @default(0)
  rowsUpserted Int       @default(0)
  desdeAno     Int?
  errorMessage String?   @db.Text
  triggeredBy  String?

  @@index([startedAt])
  @@map("naf_nomina_sync_runs")
}

/// Resumen agregado de nómina por empleado × quincena × planilla (desde NAF5.ARPLHS).
model NafNominaSummary {
  id           String   @id @default(cuid())
  noCia        String
  noEmple      String
  ano          Int
  periodo      Int
  mes          Int
  codPla       String
  nominaNombre String?
  devengado    Decimal  @db.Decimal(18, 2)
  deducciones  Decimal  @db.Decimal(18, 2)
  neto         Decimal  @db.Decimal(18, 2)
  syncedAt     DateTime @default(now())

  @@unique([noCia, ano, periodo, noEmple, codPla])
  @@index([noCia, ano, periodo])
  @@index([ano, periodo])
  @@index([noEmple])
  @@map("naf_nomina_summary")
}

/// Metadatos de quincena/planilla por empresa (desde NAF5.ARPLHCP).
model NafNominaPeriodMeta {
  id       String    @id @default(cuid())
  noCia    String
  codPla   String
  ano      Int
  periodo  Int
  mes      Int
  fDesde   DateTime?
  fHasta   DateTime?
  fCalculo DateTime?
  tipoEmp  String?
  descri   String?
  syncedAt DateTime  @default(now())

  @@unique([noCia, codPla, ano, periodo])
  @@index([ano, periodo])
  @@map("naf_nomina_period_meta")
}

/// Checklist de control por planilla/quincena en Revisión de planilla.
model NafNominaRevisionChecklist {
  id          String    @id @default(cuid())
  noCia       String
  codPla      String
  fDesde      DateTime  @db.Date
  fHasta      DateTime  @db.Date
  revisada    Boolean   @default(false)
  generada    Boolean   @default(false)
  /// Preferir pagadaCk/Dav/Bn; se mantiene por compatibilidad con Acciones NAF.
  pagada      Boolean   @default(false)
  pagadaCk    Boolean   @default(false)
