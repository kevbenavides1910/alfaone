// ─── SIG — Sistema Integrado de Gestión (DMS) ───────────────────────────────

enum SigDocumentStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SUPERSEDED
  OBSOLETE
}

enum SigAuditAction {
  CREATED
  UPDATED
  SUBMITTED_FOR_APPROVAL
  APPROVED
  REJECTED
  REVISION_DATE_UPDATED
  NEW_VERSION
  SAME_VERSION_UPDATED
  OBSOLETED
}

/// Catálogo extensible de tipos documentales (procedimiento, formulario, etc.).
model SigDocumentType {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?  @db.Text
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  documents SigDocument[]

  @@map("sig_document_types")
}

/// Procesos de negocio vinculables a documentos.
model SigProcess {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String
  description String?      @db.Text
  parentId    String?
  parent      SigProcess?  @relation("SigProcessTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    SigProcess[] @relation("SigProcessTree")
  isActive    Boolean      @default(true)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  documents            SigDocument[]
  requirementLinks     SigRequirementProcess[]
  evidences            SigEvidence[]
  controlLinks         SigControlProcess[]
  controlsPrimary      SigControl[]            @relation("SigControlPrimaryProcess")
  riskLinks            SigRiskProcess[]
  risksPrimary         SigRisk[]               @relation("SigRiskPrimaryProcess")
  legalLinks           SigLegalProcess[]
  legalPrimary         SigLegalRequirement[]   @relation("SigLegalPrimaryProcess")
  indicatorLinks       SigIndicatorProcess[]
  indicatorsPrimary    SigIndicator[]          @relation("SigIndicatorPrimaryProcess")
  auditProgramItems    AuditProgramItem[]

  @@index([parentId])
  @@map("sig_processes")
}

/// Documento lógico con control de versiones.
model SigDocument {
  id                   String              @id @default(cuid())
  code                 String              @unique
  title                String
  documentTypeId       String
  documentType         SigDocumentType     @relation(fields: [documentTypeId], references: [id], onDelete: Restrict)
  processId            String?
  process              SigProcess?         @relation(fields: [processId], references: [id], onDelete: SetNull)
  company              String?
  companyEntity        Company?            @relation(fields: [company], references: [code])
  status               SigDocumentStatus   @default(PENDING_APPROVAL)
  currentVersionId     String?             @unique
  currentVersion       SigDocumentVersion? @relation("SigCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  /// Días entre revisiones esperadas (recordatorio).
  revisionIntervalDays Int?
  createdById          String
  createdBy            User                @relation("SigDocumentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  versions         SigDocumentVersion[]     @relation("SigDocumentVersions")
  auditLogs        SigDocumentAuditLog[]
  audits           Audit[]
  requirementLinks SigRequirementDocument[]
  controlLinks     SigControlDocument[]
  programItems     AuditProgramItem[]
  legalLinks       SigLegalDocument[]

  @@index([documentTypeId])
  @@index([processId])
  @@index([status])
  @@index([company])
  @@map("sig_documents")
}

enum AuditStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum FindingSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FindingStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

enum FindingType {
  NONCONFORMITY
  OBSERVATION
  OPPORTUNITY
}

enum ActionPlanStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ActionPlanEfficacyStatus {
  PENDING
  VERIFIED
  NOT_EFFECTIVE
}

enum AuditChecklistResult {
  PENDING
  COMPLIES
  NON_COMPLIES
  NOT_APPLICABLE
}

enum AuditSampleMethod {
  RANDOM
  RISK_BASED
  AUDITOR_JUDGMENT
  MIXED
}

enum SigEvidenceType {
  PHOTO
  PDF
  EXCEL
  RECORD
  EMAIL
  ACTA
  CERTIFICATE
  INTERVIEW
  SCREENSHOT
  VIDEO
  FORM
  INSPECTION
  OTHER
}

enum SigEvidenceStatus {
  ACTIVE
  EXPIRED
  SUPERSEDED
}

enum SigEvidenceLinkRole {
  OBSERVED
  IMPLEMENTATION
  EFFICACY
}

enum SigControlStatus {
  ACTIVE
  INACTIVE
  UNDER_REVIEW
}

/// Norma / estándar del SIG (ISO 9001, ISO 18788, interno).
model SigStandard {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  year      Int?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requirements SigRequirement[]

  @@map("sig_standards")
}

/// Requisito / cláusula de una norma (matriz maestra del SIG).
model SigRequirement {
  id            String         @id @default(cuid())
  standardId    String
  standard      SigStandard    @relation(fields: [standardId], references: [id], onDelete: Restrict)
  code          String
  title         String
  description   String?        @db.Text
  parentId      String?
  parent        SigRequirement?  @relation("SigRequirementTree", fields: [parentId], references: [id], onDelete: SetNull)
  children      SigRequirement[] @relation("SigRequirementTree")
  isApplicable  Boolean        @default(true)
  sortOrder     Int            @default(0)
  createdById   String?
  createdBy     User?          @relation("SigRequirementCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  processLinks   SigRequirementProcess[]
  documentLinks  SigRequirementDocument[]
  evidenceLinks  SigEvidenceRequirement[]
  checklistItems AuditChecklistItem[]
  findingLinks   SigFindingRequirement[]
  controlLinks   SigControlRequirement[]
  riskLinks      SigRiskRequirement[]

  @@unique([standardId, code])
  @@index([parentId])
  @@index([isApplicable])
  @@map("sig_requirements")
}

model SigRequirementProcess {
  id            String         @id @default(cuid())
  requirementId String
  requirement   SigRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  processId     String
  process       SigProcess     @relation(fields: [processId], references: [id], onDelete: Cascade)
  createdAt     DateTime       @default(now())

  @@unique([requirementId, processId])
  @@index([processId])
  @@map("sig_requirement_processes")
}

model SigRequirementDocument {
  id            String         @id @default(cuid())
  requirementId String
  requirement   SigRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  documentId    String
  document      SigDocument    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdAt     DateTime       @default(now())

  @@unique([requirementId, documentId])
  @@index([documentId])
  @@map("sig_requirement_documents")
}

/// Control del SIG: puente entre requisito, proceso, documento y evidencia.
model SigControl {
  id                 String           @id @default(cuid())
  code               String           @unique
  title              String
  description        String?          @db.Text
  status             SigControlStatus @default(ACTIVE)
  processId          String?
  process            SigProcess?      @relation("SigControlPrimaryProcess", fields: [processId], references: [id], onDelete: SetNull)
  ownerUserId        String?
  ownerUser          User?            @relation("SigControlOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  /// Días esperados entre evidencias del control (alerta de frescura).
  evidenceIntervalDays Int?
  createdById        String
  createdBy          User             @relation("SigControlCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  requirementLinks SigControlRequirement[]
  processLinks     SigControlProcess[]
  documentLinks    SigControlDocument[]
  evidenceLinks    SigControlEvidence[]
  riskLinks        SigRiskControl[]
  legalLinks       SigLegalControl[]

  @@index([processId])
  @@index([status])
  @@index([ownerUserId])
  @@map("sig_controls")
}

model SigControlRequirement {
  id            String         @id @default(cuid())
  controlId     String
  control       SigControl     @relation(fields: [controlId], references: [id], onDelete: Cascade)
  requirementId String
  requirement   SigRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  createdAt     DateTime       @default(now())

  @@unique([controlId, requirementId])
  @@index([requirementId])
  @@map("sig_control_requirements")
}

model SigControlProcess {
  id        String     @id @default(cuid())
  controlId String
  control   SigControl @relation(fields: [controlId], references: [id], onDelete: Cascade)
  processId String
  process   SigProcess @relation(fields: [processId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([controlId, processId])
  @@index([processId])
  @@map("sig_control_processes")
}

model SigControlDocument {
  id         String      @id @default(cuid())
  controlId  String
  control    SigControl  @relation(fields: [controlId], references: [id], onDelete: Cascade)
  documentId String
  document   SigDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdAt  DateTime    @default(now())

  @@unique([controlId, documentId])
  @@index([documentId])
  @@map("sig_control_documents")
}

model SigControlEvidence {
  id         String      @id @default(cuid())
  controlId  String
  control    SigControl  @relation(fields: [controlId], references: [id], onDelete: Cascade)
  evidenceId String
  evidence   SigEvidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  createdAt  DateTime    @default(now())

  @@unique([controlId, evidenceId])
  @@index([evidenceId])
  @@map("sig_control_evidences")
}

/// Evidencia trazable del SIG (archivo o registro).
model SigEvidence {
  id            String            @id @default(cuid())
  code          String            @unique
  type          SigEvidenceType   @default(OTHER)
  description   String            @db.Text
  evidenceDate  DateTime
  validUntil    DateTime?
  status        SigEvidenceStatus @default(ACTIVE)
  processId     String?
  process       SigProcess?       @relation(fields: [processId], references: [id], onDelete: SetNull)
  fileName      String?
  mimeType      String?
  storagePath   String?
  fileSizeBytes Int?
  createdById   String
  createdBy     User              @relation("SigEvidenceCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  requirementLinks  SigEvidenceRequirement[]
  auditLinks        SigEvidenceAudit[]
  checklistLinks    SigEvidenceChecklistItem[]
  findingLinks      SigEvidenceFinding[]
  actionPlanLinks   SigEvidenceActionPlan[]
  controlLinks      SigControlEvidence[]
  riskLinks         SigRiskEvidence[]
  legalLinks        SigLegalEvidence[]
  indicatorMeasurements SigIndicatorMeasurement[]

  @@index([processId])
  @@index([status])
  @@index([evidenceDate])
  @@index([validUntil])
  @@map("sig_evidences")
}

enum SigRiskKind {
  RISK
  OPPORTUNITY
}

enum SigRiskStatus {
  IDENTIFIED
  ANALYZED
  TREATING
  MONITORING
  CLOSED
}

/// Riesgo u oportunidad del SIG (ISO 9001 6.1 / Manual).
model SigRisk {
  id                   String        @id @default(cuid())
  code                 String        @unique
  title                String
  description          String?       @db.Text
  kind                 SigRiskKind   @default(RISK)
  status               SigRiskStatus @default(IDENTIFIED)
  processId            String?
  process              SigProcess?   @relation("SigRiskPrimaryProcess", fields: [processId], references: [id], onDelete: SetNull)
  ownerUserId          String?
  ownerUser            User?         @relation("SigRiskOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  /// Probabilidad inherente 1–5.
  likelihood           Int           @default(3)
  /// Impacto inherente 1–5.
  impact               Int           @default(3)
  inherentScore        Int           @default(9)
  residualLikelihood   Int?
  residualImpact       Int?
  residualScore        Int?
  treatment            String?       @db.Text
  reviewDate           DateTime?
  nextReviewDate       DateTime?
  createdById          String
  createdBy            User          @relation("SigRiskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  processLinks      SigRiskProcess[]
  controlLinks      SigRiskControl[]
  requirementLinks  SigRiskRequirement[]
  evidenceLinks     SigRiskEvidence[]

  @@index([processId])
  @@index([status])
  @@index([kind])
  @@index([inherentScore])
  @@index([residualScore])
  @@index([ownerUserId])
  @@index([nextReviewDate])
  @@map("sig_risks")
}

model SigRiskProcess {
  id        String     @id @default(cuid())
  riskId    String
  risk      SigRisk    @relation(fields: [riskId], references: [id], onDelete: Cascade)
  processId String
  process   SigProcess @relation(fields: [processId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([riskId, processId])
  @@index([processId])
  @@map("sig_risk_processes")
}

model SigRiskControl {
  id        String     @id @default(cuid())
  riskId    String
  risk      SigRisk    @relation(fields: [riskId], references: [id], onDelete: Cascade)
  controlId String
  control   SigControl @relation(fields: [controlId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([riskId, controlId])
  @@index([controlId])
  @@map("sig_risk_controls")
}

model SigRiskRequirement {
  id            String         @id @default(cuid())
  riskId        String
  risk          SigRisk        @relation(fields: [riskId], references: [id], onDelete: Cascade)
  requirementId String
  requirement   SigRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  createdAt     DateTime       @default(now())

  @@unique([riskId, requirementId])
  @@index([requirementId])
  @@map("sig_risk_requirements")
}

model SigRiskEvidence {
  id         String      @id @default(cuid())
  riskId     String
  risk       SigRisk     @relation(fields: [riskId], references: [id], onDelete: Cascade)
  evidenceId String
  evidence   SigEvidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  createdAt  DateTime    @default(now())

  @@unique([riskId, evidenceId])
  @@index([evidenceId])
  @@map("sig_risk_evidences")
}

enum SigLegalComplianceStatus {
  COMPLIANT
  PARTIAL
  NON_COMPLIANT
  NOT_EVALUATED
  NOT_APPLICABLE
}

/// Requisito legal / reglamentario del SIG (matriz de cumplimiento).
model SigLegalRequirement {
  id               String                    @id @default(cuid())
  code             String                    @unique
  title            String
  description      String?                   @db.Text
  legalSource      String
  authority        String?
  articleRef       String?
  jurisdiction     String?                   @default("CR")
  processId        String?
  process          SigProcess?               @relation("SigLegalPrimaryProcess", fields: [processId], references: [id], onDelete: SetNull)
  ownerUserId      String?
  ownerUser        User?                     @relation("SigLegalRequirementOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  complianceStatus SigLegalComplianceStatus  @default(NOT_EVALUATED)
  evaluationNotes  String?                   @db.Text
  effectiveFrom    DateTime?
  effectiveUntil   DateTime?
  lastEvaluatedAt  DateTime?
  nextReviewDate   DateTime?
  createdById      String
  createdBy        User                      @relation("SigLegalRequirementCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  processLinks   SigLegalProcess[]
  documentLinks  SigLegalDocument[]
  controlLinks   SigLegalControl[]
  evidenceLinks  SigLegalEvidence[]

  @@index([processId])
  @@index([complianceStatus])
  @@index([jurisdiction])
  @@index([ownerUserId])
  @@index([nextReviewDate])
  @@index([effectiveUntil])
  @@map("sig_legal_requirements")
}

model SigLegalProcess {
  id        String              @id @default(cuid())
  legalId   String
  legal     SigLegalRequirement @relation(fields: [legalId], references: [id], onDelete: Cascade)
  processId String
  process   SigProcess          @relation(fields: [processId], references: [id], onDelete: Cascade)
  createdAt DateTime            @default(now())

  @@unique([legalId, processId])
  @@index([processId])
  @@map("sig_legal_processes")
}

model SigLegalDocument {
  id         String              @id @default(cuid())
  legalId    String
  legal      SigLegalRequirement @relation(fields: [legalId], references: [id], onDelete: Cascade)
  documentId String
  document   SigDocument         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdAt  DateTime            @default(now())

  @@unique([legalId, documentId])
  @@index([documentId])
  @@map("sig_legal_documents")
}

model SigLegalControl {
  id        String              @id @default(cuid())
  legalId   String
  legal     SigLegalRequirement @relation(fields: [legalId], references: [id], onDelete: Cascade)
  controlId String
  control   SigControl          @relation(fields: [controlId], references: [id], onDelete: Cascade)
  createdAt DateTime            @default(now())

  @@unique([legalId, controlId])
  @@index([controlId])
  @@map("sig_legal_controls")
}

model SigLegalEvidence {
  id         String              @id @default(cuid())
  legalId    String
  legal      SigLegalRequirement @relation(fields: [legalId], references: [id], onDelete: Cascade)
  evidenceId String
  evidence   SigEvidence         @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  createdAt  DateTime            @default(now())

  @@unique([legalId, evidenceId])
  @@index([evidenceId])
  @@map("sig_legal_evidences")
}

enum SigIndicatorDirection {
  HIGHER_BETTER
  LOWER_BETTER
}

enum SigIndicatorFrequency {
  WEEKLY
  MONTHLY
  QUARTERLY
  ANNUAL
  ADHOC
}

enum SigIndicatorStatus {
  ACTIVE
  INACTIVE
  UNDER_REVIEW
}

/// Indicador / KPI del SIG (ISO 9001 9.1).
model SigIndicator {
  id                 String                 @id @default(cuid())
  code               String                 @unique
  title              String
  description        String?                @db.Text
  processId          String?
  process            SigProcess?            @relation("SigIndicatorPrimaryProcess", fields: [processId], references: [id], onDelete: SetNull)
  ownerUserId        String?
  ownerUser          User?                  @relation("SigIndicatorOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  unit               String?
  direction          SigIndicatorDirection  @default(HIGHER_BETTER)
  frequency          SigIndicatorFrequency  @default(MONTHLY)
  /// Meta del indicador.
  targetValue        Decimal?               @db.Decimal(15, 4)
  /// Umbral de alerta (amarillo).
  warningThreshold   Decimal?               @db.Decimal(15, 4)
  /// Umbral crítico (rojo).
  criticalThreshold  Decimal?               @db.Decimal(15, 4)
  status             SigIndicatorStatus     @default(ACTIVE)
  formulaNotes       String?                @db.Text
  createdById        String
  createdBy          User                   @relation("SigIndicatorCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  processLinks  SigIndicatorProcess[]
  measurements  SigIndicatorMeasurement[]

  @@index([processId])
  @@index([status])
  @@index([frequency])
  @@index([ownerUserId])
  @@map("sig_indicators")
}

model SigIndicatorProcess {
  id          String       @id @default(cuid())
  indicatorId String
  indicator   SigIndicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)
  processId   String
  process     SigProcess   @relation(fields: [processId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())

  @@unique([indicatorId, processId])
  @@index([processId])
  @@map("sig_indicator_processes")
}

model SigIndicatorMeasurement {
  id           String       @id @default(cuid())
  indicatorId  String
  indicator    SigIndicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)
  periodStart  DateTime
  periodEnd    DateTime?
  value        Decimal      @db.Decimal(15, 4)
  notes        String?      @db.Text
  evidenceId   String?
  evidence     SigEvidence? @relation(fields: [evidenceId], references: [id], onDelete: SetNull)
  recordedById String
  recordedBy   User         @relation("SigIndicatorMeasurementRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([indicatorId, periodStart])
  @@index([evidenceId])
  @@index([recordedById])
  @@map("sig_indicator_measurements")
}

model SigEvidenceRequirement {
  id            String         @id @default(cuid())
  evidenceId    String
  evidence      SigEvidence    @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  requirementId String
  requirement   SigRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  createdAt     DateTime       @default(now())

  @@unique([evidenceId, requirementId])
  @@index([requirementId])
  @@map("sig_evidence_requirements")
}

model SigEvidenceAudit {
  id         String      @id @default(cuid())
  evidenceId String
  evidence   SigEvidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  auditId    String
  audit      Audit       @relation(fields: [auditId], references: [id], onDelete: Cascade)
  createdAt  DateTime    @default(now())

  @@unique([evidenceId, auditId])
  @@index([auditId])
  @@map("sig_evidence_audits")
}

model SigEvidenceChecklistItem {
  id              String             @id @default(cuid())
  evidenceId      String
  evidence        SigEvidence        @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  checklistItemId String
  checklistItem   AuditChecklistItem @relation(fields: [checklistItemId], references: [id], onDelete: Cascade)
  createdAt       DateTime           @default(now())

  @@unique([evidenceId, checklistItemId])
  @@index([checklistItemId])
  @@map("sig_evidence_checklist_items")
}

model SigEvidenceFinding {
  id         String      @id @default(cuid())
  evidenceId String
  evidence   SigEvidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  findingId  String
  finding    Finding     @relation(fields: [findingId], references: [id], onDelete: Cascade)
  createdAt  DateTime    @default(now())

  @@unique([evidenceId, findingId])
  @@index([findingId])
  @@map("sig_evidence_findings")
}

model SigEvidenceActionPlan {
  id           String              @id @default(cuid())
  evidenceId   String
  evidence     SigEvidence         @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  actionPlanId String
  actionPlan   ActionPlan          @relation(fields: [actionPlanId], references: [id], onDelete: Cascade)
  role         SigEvidenceLinkRole @default(IMPLEMENTATION)
  createdAt    DateTime            @default(now())

  @@unique([evidenceId, actionPlanId, role])
  @@index([actionPlanId])
  @@map("sig_evidence_action_plans")
}

model SigFindingRequirement {
  id            String         @id @default(cuid())
  findingId     String
  finding       Finding        @relation(fields: [findingId], references: [id], onDelete: Cascade)
  requirementId String
  requirement   SigRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  createdAt     DateTime       @default(now())

  @@unique([findingId, requirementId])
  @@index([requirementId])
  @@map("sig_finding_requirements")
}

/// Auditoría trimestral asociada a un procedimiento vigente del SIG.
model Audit {
  id            String      @id @default(cuid())
  procedureId   String
  procedure     SigDocument @relation(fields: [procedureId], references: [id], onDelete: Restrict)
  year          Int
  quarter       Int
  scheduledDate DateTime
  status        AuditStatus @default(PLANNED)
  scope         String?     @db.Text
  objective     String?     @db.Text
  notes         String?     @db.Text
  auditorId     String?
  auditor       User?       @relation("AuditAuditor", fields: [auditorId], references: [id], onDelete: SetNull)
  createdById   String
  createdBy     User        @relation("AuditCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  findings       Finding[]
  checklistItems AuditChecklistItem[]
  samples        AuditSample[]
  evidenceLinks  SigEvidenceAudit[]
  programItems   AuditProgramItem[]

  @@unique([procedureId, year, quarter])
  @@index([year, quarter])
  @@index([status])
  @@index([auditorId])
  @@map("sig_audits")
}

enum AuditProgramStatus {
  DRAFT
  APPROVED
  IN_PROGRESS
  CLOSED
}

enum AuditProgramPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AuditProgramItemStatus {
  PLANNED
  SCHEDULED
  COMPLETED
  CANCELLED
  DEFERRED
}

/// Programa anual de auditorías internas (F-SIG-21).
model AuditProgram {
  id           String             @id @default(cuid())
  year         Int                @unique
  title        String
  status       AuditProgramStatus @default(DRAFT)
  notes        String?            @db.Text
  approvedAt   DateTime?
  approvedById String?
  approvedBy   User?              @relation("AuditProgramApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  createdById  String
  createdBy    User               @relation("AuditProgramCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  items AuditProgramItem[]

  @@index([status])
  @@map("sig_audit_programs")
}

/// Ítem del programa: proceso/procedimiento planificado en un mes.
model AuditProgramItem {
  id              String                @id @default(cuid())
  programId       String
  program         AuditProgram          @relation(fields: [programId], references: [id], onDelete: Cascade)
  processId       String?
  process         SigProcess?           @relation(fields: [processId], references: [id], onDelete: SetNull)
  procedureId     String?
  procedure       SigDocument?          @relation(fields: [procedureId], references: [id], onDelete: SetNull)
  plannedMonth    Int
  plannedQuarter  Int
  priority        AuditProgramPriority  @default(MEDIUM)
  priorityScore   Int                   @default(0)
  priorityReason  String?               @db.Text
  scope           String?               @db.Text
  objective       String?               @db.Text
  notes           String?               @db.Text
  status          AuditProgramItemStatus @default(PLANNED)
  auditorId       String?
  auditor         User?                 @relation("AuditProgramItemAuditor", fields: [auditorId], references: [id], onDelete: SetNull)
  linkedAuditId   String?
  linkedAudit     Audit?                @relation(fields: [linkedAuditId], references: [id], onDelete: SetNull)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([programId])
  @@index([processId])
  @@index([procedureId])
  @@index([plannedMonth])
  @@index([priority])
  @@index([status])
  @@index([linkedAuditId])
  @@map("sig_audit_program_items")
}

model AuditChecklistItem {
  id            String               @id @default(cuid())
  auditId       String
  audit         Audit                @relation(fields: [auditId], references: [id], onDelete: Cascade)
  stage         String
  requirement   String?              @db.Text
  requirementId String?
  sigRequirement SigRequirement?     @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  result        AuditChecklistResult @default(PENDING)
  notes         String?              @db.Text
  evidence      String?              @db.Text
  sortOrder     Int                  @default(0)
  reviewedAt    DateTime?
  reviewedById  String?
  reviewedBy    User?                @relation("AuditChecklistReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  findings       Finding[]
  evidenceLinks  SigEvidenceChecklistItem[]

  @@index([auditId])
  @@index([result])
  @@index([requirementId])
  @@map("sig_audit_checklist_items")
}

model AuditSample {
  id                     String            @id @default(cuid())
  auditId                String
  audit                  Audit             @relation(fields: [auditId], references: [id], onDelete: Cascade)
  populationDescription  String            @db.Text
  populationSize         Int?
  sampleSize             Int?
  method                 AuditSampleMethod @default(AUDITOR_JUDGMENT)
  notes                  String?           @db.Text
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  items AuditSampleItem[]

  @@index([auditId])
  @@map("sig_audit_samples")
}

model AuditSampleItem {
  id        String      @id @default(cuid())
  sampleId  String
  sample    AuditSample @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  code      String?
  label     String
  notes     String?     @db.Text
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())

  @@index([sampleId])
  @@map("sig_audit_sample_items")
}

model Finding {
  id                      String          @id @default(cuid())
  auditId                 String
  audit                   Audit           @relation(fields: [auditId], references: [id], onDelete: Cascade)
  title                   String
  description             String          @db.Text
  findingType             FindingType     @default(NONCONFORMITY)
  severity                FindingSeverity @default(MEDIUM)
  status                  FindingStatus   @default(OPEN)
  criterionText           String?         @db.Text
  evidenceStatement       String?         @db.Text
  nonconformityStatement  String?         @db.Text
  rootCause               String?         @db.Text
  checklistItemId         String?
  checklistItem           AuditChecklistItem? @relation(fields: [checklistItemId], references: [id], onDelete: SetNull)
  createdById             String
  createdBy               User            @relation("FindingCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  actionPlans      ActionPlan[]
  evidenceLinks    SigEvidenceFinding[]
  requirementLinks SigFindingRequirement[]

  @@index([auditId])
  @@index([status])
  @@index([findingType])
  @@index([checklistItemId])
  @@map("sig_audit_findings")
}

model ActionPlan {
  id                   String                   @id @default(cuid())
  findingId            String
  finding              Finding                  @relation(fields: [findingId], references: [id], onDelete: Cascade)
  title                String
  description          String                   @db.Text
  correctionImmediate  String?                  @db.Text
  responsibleName      String?
  responsibleUserId    String?
  responsibleUser      User?                    @relation("ActionPlanResponsible", fields: [responsibleUserId], references: [id], onDelete: SetNull)
  dueDate              DateTime?
  status               ActionPlanStatus         @default(PENDING)
  efficacyStatus       ActionPlanEfficacyStatus @default(PENDING)
  efficacyVerifiedAt   DateTime?
  efficacyVerifiedById String?
  efficacyVerifiedBy   User?                    @relation("ActionPlanEfficacyVerifier", fields: [efficacyVerifiedById], references: [id], onDelete: SetNull)
  efficacyNotes        String?                  @db.Text
  createdById          String
  createdBy            User                     @relation("ActionPlanCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  followUps     FollowUp[]
  evidenceLinks SigEvidenceActionPlan[]

  @@index([findingId])
  @@index([status])
  @@index([dueDate])
  @@index([responsibleUserId])
  @@index([efficacyStatus])
  @@map("sig_action_plans")
}

model FollowUp {
  id           String           @id @default(cuid())
  actionPlanId String
  actionPlan   ActionPlan       @relation(fields: [actionPlanId], references: [id], onDelete: Cascade)
  note         String           @db.Text
  status       ActionPlanStatus
  followUpDate DateTime         @default(now())
  createdById  String
  createdBy    User             @relation("FollowUpCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([actionPlanId])
  @@index([followUpDate])
  @@map("sig_follow_ups")
}

/// Versión física del documento (archivo en disco bajo sig-documents/).
model SigDocumentVersion {
  id                 String             @id @default(cuid())
  documentId         String
  document           SigDocument        @relation("SigDocumentVersions", fields: [documentId], references: [id], onDelete: Cascade)
  versionNumber      Int
  versionLabel       String
  fileName           String
  mimeType           String
  storagePath        String
  fileSizeBytes      Int
  checksum           String?
  revisionDate       DateTime
  effectiveFrom      DateTime
  effectiveUntil     DateTime?
  changeSummary      String?            @db.Text
  status             SigDocumentStatus  @default(PENDING_APPROVAL)
  uploadedById       String
  uploadedBy         User               @relation("SigVersionUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  assignedApproverId String?
  assignedApprover   User?              @relation("SigVersionAssignedApprover", fields: [assignedApproverId], references: [id], onDelete: SetNull)
  approvedById       String?
  approvedBy         User?              @relation("SigVersionApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt         DateTime?
  rejectionNote      String?            @db.Text
  /// Texto extraído (PDF nativo, Office, OCR) para búsqueda por contenido.
  extractedText      String?            @db.Text
  textIndexStatus    SigTextIndexStatus @default(PENDING)
  textIndexedAt      DateTime?
  createdAt          DateTime           @default(now())

  currentFor SigDocument?          @relation("SigCurrentVersion")
  auditLogs  SigDocumentAuditLog[]

  @@unique([documentId, versionNumber])
  @@index([documentId])
  @@index([status])
  @@index([assignedApproverId])
  @@map("sig_document_versions")
}

enum SigTextIndexStatus {
  PENDING
  DONE
  FAILED
  SKIPPED
}

/// Bitácora de aprobaciones y cambios del módulo SIG.
model SigDocumentAuditLog {
  id           String              @id @default(cuid())
  documentId   String
  document     SigDocument         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionId    String?
  version      SigDocumentVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)
  action       SigAuditAction
  actorId      String
  actor        User                @relation("SigAuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  notes        String?             @db.Text
  metadataJson String?             @db.Text
  createdAt    DateTime            @default(now())

  @@index([documentId])
  @@index([versionId])
  @@index([createdAt])
  @@map("sig_document_audit_logs")
}

// ─── Alfa One — App móvil recorridos NFC ─────────────────────────────────────

/// Ajustes remotos para la app móvil Alfa One (fila única id = default).
model AppSyntraSettings {
  id                 String   @id @default("default")
  enableGeofences    Boolean  @default(false)
  enableGpsTrack     Boolean  @default(false)
  geofenceRadiusM    Int      @default(100)
  routesSyncMinutes  Int      @default(360)
  reportsSyncMinutes Int      @default(30)
  updatedAt          DateTime @updatedAt

  @@map("app_syntra_settings")
}

/// Dispositivo móvil Alfa One (IMEI + empleado asignado).
model PatrolDevice {
  id               String    @id @default(cuid())
  imei             String    @unique
  employeeCode     String
  passwordHash     String
  label            String?
  locationDesc     String?
  positionId       String?
  assetId          String?
  isActive         Boolean   @default(true)
  lastLoginAt      DateTime?
  lastGpsLatitude  Decimal?  @db.Decimal(10, 7)
  lastGpsLongitude Decimal?  @db.Decimal(10, 7)
