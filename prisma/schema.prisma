  deviceId          String?
  imei              String
  employeeCode      String
  description       String   @db.Text
  routeCode         String?
  incidentAt        DateTime
  imageMimeType     String?
  imageFileName     String?
  imagePath         String?
  source            String   @default("APP")
  linkedOmissionKey String?
  createdAt         DateTime @default(now())
