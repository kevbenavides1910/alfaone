  @@map("patrol_gps_tracks")
}

// ─── Módulo Monitoreo (alarmas; tablas históricas bandeco_*) ──────────────────

/// Catálogo principal: código de alarma → finca, zona, motorizado, contactos.
model BandecoAlarmCode {
  id              String   @id @default(cuid())
  alarmNumber     Int      @unique
  finca           String
  zona            String
  motorizado      String
  bodycam         String?
  grupoWsp        String?
  encargado       String?
  numeroEncargado String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  pantalla         BandecoPantalla?
  activaciones     BandecoActivacion[]
  aperturasCierres BandecoAperturaCierre[]

  @@index([finca])
  @@map("bandeco_alarm_codes")
}

/// Mapeo pantalla/cámara por código de alarma (hoja PANTALLAS).
model BandecoPantalla {
  id          String           @id @default(cuid())
  alarmCodeId String           @unique
  alarmCode   BandecoAlarmCode @relation(fields: [alarmCodeId], references: [id], onDelete: Cascade)
  finca       String
  zona        String
  pantalla    Int?
  camara      Int?
  zonaExterna String?
  pantalla2   Int?
  camara2     Int?

  @@map("bandeco_pantallas")
}

/// Puestos / motorizados (hoja PUESTOS).
model BandecoPuesto {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("bandeco_puestos")
}

/// Descripción de cámaras por pantalla (hoja CAMARAS).
model BandecoCamara {
  id          String @id @default(cuid())
  pantallaNum Int
  camaraNum   Int
  descripcion String

  @@unique([pantallaNum, camaraNum])
  @@map("bandeco_camaras")
}

/// Cuentas de apertura por finca (hoja APERTURAS).
model BandecoAperturaCuenta {
  id           String @id @default(cuid())
  finca        String
  cuentaNum    Int
  nombreCuenta String

  @@index([finca])
  @@index([cuentaNum])
  @@map("bandeco_apertura_cuentas")
}

/// Configuración de reporte de pilas por finca (hoja PILAS).
model BandecoPilaFinca {
  id             String  @id @default(cuid())
  finca          String  @unique
  desmane        String?
  paneo          String?
  zonaMotorizado String?
  observaciones  String?

  llenados BandecoPilaLlenado[]

  @@map("bandeco_pila_fincas")
}

/// Registro diario de llenado de pilas (operación).
model BandecoPilaLlenado {
  id               String          @id @default(cuid())
  fecha            DateTime        @db.Date
  finca            String
  pilaFincaId      String?
  pilaFinca        BandecoPilaFinca? @relation(fields: [pilaFincaId], references: [id], onDelete: SetNull)
  desmane          String?
  paneo            String?
  observaciones    String?
  recomendaciones  String?         @db.Text
  operadorName     String
  operadorId       String?
  imagenes         Json?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([fecha, finca])
  @@index([fecha])
  @@index([finca])
  @@map("bandeco_pila_llenados")
}

/// Registro de activaciones (hoja REGISTRO).
model BandecoActivacion {
  id              String            @id @default(cuid())
  activatedAt     DateTime          @default(now())
  alarmNumber     Int
  alarmCodeId     String?
  alarmCode       BandecoAlarmCode? @relation(fields: [alarmCodeId], references: [id], onDelete: SetNull)
  finca           String
  zona            String
  motorizado      String?
  bodycam         String?
  grupoWsp        String?
  encargado       String?
  numeroEncargado String?
  operadorName    String
  operadorId      String?
  estado          String?
  informe         String?           @db.Text
  mensaje         String?           @db.Text
  tipoActivacion  String?
  imagenes        Json?

  @@index([activatedAt])
  @@index([alarmNumber])
  @@map("bandeco_activaciones")
}

/// Aperturas y cierres (hoja APEYCE).
model BandecoAperturaCierre {
  id           String            @id @default(cuid())
  finca        String
  codigo       Int
