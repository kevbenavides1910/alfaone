{
  "$comment": "Sincronizar con src/lib/modules/registry.ts y .github/workflows/ci.yml",
  "shared": [
    "prisma/**",
    "package.json",
    "package-lock.json",
    "Dockerfile",
    "docker-compose.yml",
    ".dockerignore",
    "next.config.ts",
    "tsconfig.json",
    "tailwind.config.ts",
    "postcss.config.js",
    "src/lib/**",
    "src/app/layout.tsx",
    "src/app/globals.css",
    "src/app/page.tsx",
    "src/components/layout/**",
    "src/components/ui/**",
    "src/components/branding/**",
    "src/providers/**"
  ],
  "modules": {
    "core": [
      "src/modules/core/**",
      "src/app/(auth)/**",
      "src/app/(app)/dashboard/**",
      "src/app/api/auth/**",
      "src/app/api/companies/**",
      "src/app/api/branding/**"
    ],
    "presupuestos": [
      "src/modules/presupuestos/**",
      "src/app/(app)/contracts/**",
      "src/app/(app)/expenses/**",
      "src/app/api/contracts/**",
      "src/app/api/expenses/**",
      "src/app/api/import/**",
      "src/app/api/positions/**",
      "src/components/contracts/**",
      "src/components/expenses/**",
      "src/components/shared/**"
    ],
    "reportes": [
      "src/app/(app)/reports/**",
      "src/app/api/reports/**",
      "src/components/reports/**"
    ],
    "inventario": [
      "src/modules/inventario/**",
      "src/app/(app)/inventory/**",
      "src/app/api/assets/**",
      "src/app/api/asset-movements/**",
