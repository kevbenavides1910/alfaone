      "src/app/api/admin/catalogs/asset-types/**",
      "src/components/contracts/AssetsTab.tsx",
      "src/components/admin/AssetTypesTab.tsx"
    ],
    "disciplinario": [
      "src/modules/disciplinario/**",
      "src/app/(app)/disciplinario/**",
      "src/app/api/disciplinary/**",
      "src/app/api/admin/disciplinary/**",
      "src/components/disciplinary/**",
      "prisma/migrations/*disciplinary*",
      "prisma/clear-disciplinary-data.ts"
