    "plataforma": [
      "src/modules/plataforma/**",
      "src/app/(app)/admin/**",
      "src/app/api/admin/**",
      "src/app/api/users/**",
      "src/components/admin/**"
    ],
    "expedienteDigital": [
      "src/modules/expediente-digital/**",
      "src/app/(app)/expediente-digital/**",
      "src/app/api/expediente-digital/**",
      "src/components/expediente-digital/**"
    ]
  }
