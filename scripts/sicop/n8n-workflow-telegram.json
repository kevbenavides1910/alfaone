' nuevas, ' + (ao.updated || 0) + ' actualizadas\\n';\n}\nif (ao.error) {\n  m += '⚠️ *Error ingest:* ' + ao.error + '\\n';\n}\nm += '\\n━━━━━━━━━━━━━━━━━━━━━━━━\\n\\n';\nt.slice(0, 10).forEach((x, i) => {\n  const desc = String(x.description || '').replace(/\\(/g, '\\\\(').replace(/\\)/g, '\\\\)');\n  m += (i + 1) + '️⃣ *' + desc + '*\\n';\n  m += '🏛 *Inst:* ' + (x.institution || '') + '\\n';\n  m += '📋 *Exp:* ' + (x.number || '') + '\\n';\n  m += '📆 *Publicación:* ' + (x.publication_date || '') + '\\n';\n  m += '🔵 *Estado:* ' + (x.status || '') + '\\n\\n';\n});\nif (t.length > 10) m += '...y ' + (t.length - 10) + ' más';\nreturn [{ json: { message: m } }];"}},{"id":"45557ac7-1355-4a79-90ac-d98972aeb16c","name":"Enviar Telegram","type":"n8n-nodes-base.telegram","typeVersion":1,"position":[1500,150],"parameters":{"resource":"message","operation":"sendMessage","chatId":"7541752085","text":"={{ \\.message }}","additionalFields":{"parse_mode":"Markdown"}},"credentials":{"telegramApi":{"id":"2","name":"Telegram SICOP Bot"}}},{"id":"a35295cd-e1f4-421b-9e26-1f3a80505d8c","name":"Sin resultados","type":"n8n-nodes-base.code","typeVersion":2,"position":[1250,500],"parameters":{"jsCode":"return [{ json: { message: '✅ *Sin novedades*\\n\\nNo se encontraron licitaciones de seguridad/vigilancia nuevas en la última semana.' } }];"}},{"id":"9bf84670-24ee-49cf-92bf-4c05e3282307","name":"Enviar Telegram (vacio)","type":"n8n-nodes-base.telegram","typeVersion":1,"position":[1500,500],"parameters":{"resource":"message","operation":"sendMessage","chatId":"7541752085","text":"={{ \\.message }}","additionalFields":{"parse_mode":"Markdown"}},"credentials":{"telegramApi":{"id":"2","name":"Telegram SICOP Bot"}}}],"connections":{"Parsear JSON":{"main":[[{"node":"Hay resultados?","type":"main","index":0}]]},"Hay resultados?":{"main":[[{"node":"Formatear","type":"main","index":0}],[{"node":"Sin resultados","type":"main","index":0}]]},"Formatear":{"main":[[{"node":"Enviar Telegram","type":"main"